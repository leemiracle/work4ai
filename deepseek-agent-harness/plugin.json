{
  "id": "agent-dev",
  "name": "Agent Systems Plugin",
  "version": "0.1.0",
  "description": "Agent 领域插件：金字塔 L1-L4（lint→单测→轨迹冒烟→任务评测+成本基线）+ 三病治理的 agent 特化（跳过校验/自我提权=Goodhart / 六组件改动影响面=盲区 / 轨迹与状态目录=冲突热点）。知识底座挂网 harness工程手册 15 章。",
  "engine": {
    "protocol": "openai-compatible", "registry": "engines/dialects.py", "probe": "engine_probe.py",
    "env": {"KH_BASE_URL": "端点", "KH_API_KEY": "密钥", "KH_LOOP_MODEL": "工具循环模型", "KH_THINKER_MODEL": "规划模型"},
    "engines": ["zhipu✅", "deepseek", "dashscope", "moonshot", "openai", "anthropic", "gemini", "local(vllm/ollama)"],
    "router": {"policy": "cascade"}
  },
  "instructions": "AGENTS.md",
  "mount_points": {
    "E": {"bootstrap": "AGENTS.md + progress.md 断点续传"},
    "T": {"tools_dir": "tools/", "extra_tools": ["agent_lint", "agent_test", "agent_smoke", "agent_eval", "graph_guard", "graph_conflict", "patch_queue_status"]},
    "C": {"tool_result_cap": 16000, "compact_trigger": 0.8, "keep_recent": 20000},
    "S": {"ledger": "state/patch_ledger.jsonl", "progress": "state/progress.md", "append_only": true},
    "L": {"authorize_hook": "hooks/authorize.py", "fail_closed": true, "agent_redlines": "删轨迹 / 对外 API 无预算 / 改 authorize=提权 / --no-verify"},
    "V": {"pyramid": ["L1 lint", "L2 轨迹 schema+配对", "L3 循环冒烟", "L4 任务评测+成本基线"], "gate": "governance 三查"}
  },
  "governance": {
    "goodhart": "跳过校验/假基线/选择性报告",
    "blindspot": "六组件任一改动的影响面（对照 knowledge/agent_design.md 检查单）",
    "conflict": "轨迹/状态目录共享热点"
  },
  "env": {"AGENT_PROJECT": "agent 项目根"},
  "knowledge": "knowledge/agent_design.md（六组件检查单+生态工具带+挂网手册）",
  "self_test": "python3 agent_host.py --self-test"
}
