  {
   "id": "file:packages/sandbox/sandbox-windows-acl/src/token.ts",
   "type": "file",
   "name": "token.ts",
   "filePath": "packages/sandbox/sandbox-windows-acl/src/token.ts",
   "summary": "受限 token 构造：打开当前进程 token、提取 logon SID、构建 well-known SID、按模式调 CreateRestrictedToken 组装 restricting-SID allowlist（read-only [logon,EVERYONE]；workspace-write 追加 workspace/temp 写 SID）；每个 API 调用都检查，失败带 API 名与精确 Win32 码抛出——原 POC 全部忽略并静默以完整未限 token 跑子进程。",
   "tags": [
    "restricted-token",
    "win32-api",
    "fail-closed"
   ],
   "complexity": "complex",
   "languageNotes": "keep-alive 组（logon SID+EVERYONE）两模式共享（缺它 DLL init 0xC0000142、CNG 崩溃）；Authenticated Users/INTERACTIVE/LOCAL 两列表均缺席以关闭 CIM 与 Public tree 逃逸。"
  },
  {
   "id": "function:packages/sandbox/sandbox-windows-acl/src/token.ts:openCurrentProcessToken",
   "type": "function",
   "name": "openCurrentProcessToken",
   "filePath": "packages/sandbox/sandbox-windows-acl/src/token.ts",
   "lineRange": [
    23,
    42
   ],
   "summary": "经真实 OpenProcess 句柄（GetCurrentProcess 伪句柄不可经 koffi 寻址）打开当前进程 token，权限为 CreateRestrictedToken 所需集合。",
   "tags": [
    "win32-api",
    "token-handle",
    "win32"
   ],
   "complexity": "simple"
  },
