 "nodes": [
  {"id": "document:packages/sdk/README.md", "type": "document", "name": "README.md", "filePath": "packages/sdk/README.md", "summary": "sdk 包组 README：让另一进程经换行分隔 JSON-RPC 驱动完整 DeepSeek Harness 运行时——protocol 定义公共消息、TypeScript client 以命名 profile+有序补丁启动 dsh、server 在 stdio 上应答；TS client 与 Python SDK 同协议，不创建开发者项目也不定义另一个应用。", "tags": ["documentation", "package-group", "sdk", "json-rpc"], "complexity": "simple"},
  {"id": "document:packages/sdk/client/README.md", "type": "document", "name": "README.md", "filePath": "packages/sdk/client/README.md", "summary": "dsh-sdk-client 包 README：TS 程序经 stdio JSON-RPC 驱动完整运行时——run() 支持普通文本/受支持的斜杠命令/图像内容块，onNotification 观察通知；HarnessClient 提供直接协议访问；可给 dshBin 否则解析同版本 @deepseek-ai/dsh 可执行文件；客户端拥有子进程并在 close()/await using 时回收。", "tags": ["documentation", "sdk-client", "subprocess"], "complexity": "moderate"},
  {"id": "config:packages/sdk/client/package.json", "type": "config", "name": "package.json", "filePath": "packages/sdk/client/package.json", "summary": "@deepseek-ai/dsh-sdk-client 包清单：TS SDK 客户端的依赖（同版本 dsh）与导出。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "file:packages/sdk/client/src/api.ts", "type": "file", "name": "api.ts", "filePath": "packages/sdk/client/src/api.ts", "summary": "HarnessClient 之上的高层 run API：DeepSeekHarness 惰性启动运行时子进程并做 initialize 握手（失败清理后换新 client 可重试）；HarnessSession 按 sessionId 经 queryInput 路由提示词或原生命令，RunActivity 从收据起收集该输入的根事件与 Session 树通知，命令路径以 session.query.completed 收口、提示词路径以 session.status idle 收口。", "tags": ["high-level-api", "run-loop", "activity-collection"], "complexity": "complex", "languageNotes": "握手失败时清理也失败则抛 AggregateError 保序保留双因；cwd 在握手前解析为绝对路径防子进程内二次相对解析（worker→worker/worker）。"},
  {"id": "class:packages/sdk/client/src/api.ts:DeepSeekHarness", "type": "class", "name": "DeepSeekHarness", "filePath": "packages/sdk/client/src/api.ts", "lineRange": [21, 148], "summary": "可复用 SDK 门面（AsyncDisposable）：memoize 握手、session()/resumeSession() 建/恢复会话句柄、run() 转发、close() 幂等终结；provider/model 默认 deepseek-official/deepseek-v4-flash。", "tags": ["facade", "async-disposable", "handshake-retry"], "complexity": "complex"},
  {"id": "function:packages/sdk/client/src/api.ts:createProcessDeepSeekHarness", "type": "function", "name": "createProcessDeepSeekHarness", "filePath": "packages/sdk/client/src/api.ts", "lineRange": [151, 163], "summary": "对通用进程构造高层 API，供包内 fake-runtime 测试注入 client 工厂。", "tags": ["test-hook", "factory"], "complexity": "simple"},
  {"id": "class:packages/sdk/client/src/api.ts:RunActivity", "type": "class", "name": "RunActivity", "filePath": "packages/sdk/client/src/api.ts", "lineRange": [177, 220], "summary": "单输入活动收集器：忽略收据前流量，验证根事件（validatedSessionEvent）后推给观察者；命令完成须有匹配 command/done 生命周期否则 SdkProtocolError；result 汇总 finalResponse（取最后一条 assistant/message 文本）与 finishReason。", "tags": ["activity-interval", "receipt-matching", "result-assembly"], "complexity": "moderate"},
  {"id": "class:packages/sdk/client/src/api.ts:HarnessSession", "type": "class", "name": "HarnessSession", "filePath": "packages/sdk/client/src/api.ts", "lineRange": [225, 303], "summary": "一个 SDK 会话句柄：稳定 id + 工作目录读写 + run()（订阅 Session 树通知，命令路径等 session.query.completed 并排队消费其生命周期，提示词路径等到 idle）；目标创建/恢复含 goal 终止与收尾回复的自动轮次，原生 handler 拒绝返回 finishReason=error。", "tags": ["session-handle", "notification-loop", "command-vs-prompt"], "complexity": "complex"},
  {"id": "function:packages/sdk/client/src/api.ts:validatedTurnEndReason", "type": "function", "name": "validatedTurnEndReason", "filePath": "packages/sdk/client/src/api.ts", "lineRange": [306, 330], "summary": "校验 wire 上 turn/end 原因包络：aborted 分支要求 reason.kind 属 user/parent/disposed/legacy/hook（hook 需字符串 reason），其余抛 SdkProtocolError。", "tags": ["validation", "wire-shapes"], "complexity": "simple"},
  {"id": "function:packages/sdk/client/src/api.ts:validatedSessionEvent", "type": "function", "name": "validatedSessionEvent", "filePath": "packages/sdk/client/src/api.ts", "lineRange": [337, 359], "summary": "校验 SDK 读取的事件字段：assistant/message 的 content 必须是带字符串 type 的块数组、turn/end 必须携带合法 reason；其余变体按包络形状透传。", "tags": ["validation", "provider-read-fields"], "complexity": "moderate"},
  {"id": "function:packages/sdk/client/src/api.ts:finalResponse", "type": "function", "name": "finalResponse", "filePath": "packages/sdk/client/src/api.ts", "lineRange": [373, 383], "summary": "倒序找最后一条 assistant/message 并拼接其 text 块作为最终回复，无则空串。", "tags": ["response-extraction", "text-concatenation"], "complexity": "simple"},
  {"id": "file:packages/sdk/client/src/client.ts", "type": "file", "name": "client.ts", "filePath": "packages/sdk/client/src/client.ts", "summary": "低层 JSON-RPC 客户端：HarnessClient 拥有运行时子进程（在 harness 上下文之外运行故直连 spawn，是 dsh-subprocess 缝的文档化例外），经 stdio 说 sdk-protocol，把服务器通知扇出到订阅，close 走 EOF→SIGTERM→SIGKILL 静默梯；无 wire 级取消——超时请求在服务器侧继续运行直到运行时关闭。Python SDK 的 HarnessClient 是其设计孪生。", "tags": ["json-rpc-client", "subprocess-ownership", "notification-fanout"], "complexity": "complex", "languageNotes": "stderr 保留 400 行尾部诊断意外死亡；流退场后固定 100ms settle 窗；TransportClosedError/RequestTimeoutError/SdkProtocolError 三类定型失败。"},
  {"id": "class:packages/sdk/client/src/client.ts:TransportClosedError", "type": "class", "name": "TransportClosedError", "filePath": "packages/sdk/client/src/client.ts", "lineRange": [44, 50], "summary": "运行时子进程已死或不可用（退出/stdio 关闭/无法启动），消息携带退出码与 stderr 尾部。", "tags": ["error-type", "transport-lifecycle"], "complexity": "simple"},
  {"id": "class:packages/sdk/client/src/client.ts:RequestTimeoutError", "type": "class", "name": "RequestTimeoutError", "filePath": "packages/sdk/client/src/client.ts", "lineRange": [53, 59], "summary": "请求超过 requestTimeoutMs 的超时错误。", "tags": ["error-type", "timeout"], "complexity": "simple"},
  {"id": "class:packages/sdk/client/src/client.ts:SdkProtocolError", "type": "class", "name": "SdkProtocolError", "filePath": "packages/sdk/client/src/client.ts", "lineRange": [65, 71], "summary": "运行时应答超出其文档化协议（如 session/prompt 响应缺 accepted: true）的错误。", "tags": ["error-type", "protocol-violation"], "complexity": "simple"},
  {"id": "class:packages/sdk/client/src/client.ts:NotificationSubscriptionImpl", "type": "class", "name": "NotificationSubscriptionImpl", "filePath": "packages/sdk/client/src/client.ts", "lineRange": [101, 179], "summary": "通知订阅实现：next 等待/tryNext 无等待排空、close 丢弃队列并拒绝等待者；运行时死亡的 fail 保留队列可继续排空；过滤器抛错只终结本订阅，不打扰兄弟订阅或传输读循环。", "tags": ["subscription", "async-iterable", "failure-isolation"], "complexity": "moderate"},
  {"id": "class:packages/sdk/client/src/client.ts:HarnessClient", "type": "class", "name": "HarnessClient", "filePath": "packages/sdk/client/src/client.ts", "lineRange": [190, 572], "summary": "核心协议客户端：start 惰性 spawn、initialize/prompt/resumeSession/工作目录方法、subscribe/subscribeSessionTree（按 sessionParents 判后代关系）、onRequest 应答服务器反向请求（user-question/approval）、close 先协议 shutdown 再走处置梯；closedError 汇总 spawn 错误/退出码/stderr 尾部。", "tags": ["json-rpc-client", "session-tree", "bidirectional-rpc", "teardown-ladder"], "complexity": "complex"},
  {"id": "function:packages/sdk/client/src/client.ts:createProcessHarnessClient", "type": "function", "name": "createProcessHarnessClient", "filePath": "packages/sdk/client/src/client.ts", "lineRange": [575, 581], "summary": "对通用进程构造 HarnessClient，供包内 fake-runtime 测试。", "tags": ["test-hook", "factory"], "complexity": "simple"},
  {"id": "function:packages/sdk/client/src/client.ts:queryInput", "type": "function", "name": "queryInput", "filePath": "packages/sdk/client/src/client.ts", "lineRange": [590, 608], "summary": "高层 run API 的路由输入发送：session/query 后校验 prompt（messageId）或 command（execution 解码）二态结果，非法即 SdkProtocolError；不在包导出中。", "tags": ["routing", "wire-validation"], "complexity": "simple"},
  {"id": "function:packages/sdk/client/src/client.ts:commandExecution", "type": "function", "name": "commandExecution", "filePath": "packages/sdk/client/src/client.ts", "lineRange": [629, 647], "summary": "解码原生 handler 的命令结果：success（可选 text 与非负安全整数 sourceEventSeq→SessionSeq）或 error（非空 text），其余抛协议错。", "tags": ["decoding", "wire-validation"], "complexity": "simple"},
  {"id": "function:packages/sdk/client/src/client.ts:isRecord", "type": "function", "name": "isRecord", "filePath": "packages/sdk/client/src/client.ts", "lineRange": [624, 626], "summary": "wire 边界形状探针：非空非数组对象。", "tags": ["type-guard", "wire-boundary"], "complexity": "simple"},
  {"id": "file:packages/sdk/client/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/sdk/client/src/index.ts", "summary": "dsh-sdk-client 包入口 barrel：导出 DeepSeekHarness/HarnessSession/validatedSessionEvent、HarnessClient 与三类错误、通知订阅类型及共享 wire 类型；纯库不在 Cordis 上下文注册任何东西。", "tags": ["entry-point", "barrel", "pure-library"], "complexity": "simple"},
  {"id": "file:packages/sdk/client/src/types.ts", "type": "file", "name": "types.ts", "filePath": "packages/sdk/client/src/types.ts", "summary": "TS SDK 客户端类型：HarnessNotification（method+raw params）、NotificationFilter、HarnessClientOptions（dshBin/profile/超时/user-question 回调）、DeepSeekHarnessOptions、RunResult 等启动选项与自有活动结果。", "tags": ["type-definition", "client-options", "notifications"], "complexity": "moderate"},
  {"id": "document:packages/sdk/protocol/README.md", "type": "document", "name": "README.md", "filePath": "packages/sdk/protocol/README.md", "summary": "dsh-sdk-protocol 包 README：运行时与 SDK 客户端经换行分隔字节流交换 JSON-RPC 2.0——一个传输类+两端共说的具名请求/结果/通知类型；服务端是 dsh-sdk-jsonrpc-server 插件，客户端是 TS dsh-sdk-client 与镜像同形状但不 import 的 Python SDK；纯库无插件无配置。", "tags": ["documentation", "wire-protocol", "pure-library"], "complexity": "moderate"},
  {"id": "config:packages/sdk/protocol/package.json", "type": "config", "name": "package.json", "filePath": "packages/sdk/protocol/package.json", "summary": "@deepseek-ai/dsh-sdk-protocol 包清单：SDK wire 协议的依赖与导出。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "file:packages/sdk/protocol/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/sdk/protocol/src/index.ts", "summary": "协议包入口：重导出 JsonRpcLineTransport/JsonRpcResponseError 与全部具名 wire 类型（Initialize/Session query/prompt/resume/wait/工作目录/用户问答/审批/subagent 通知等）。", "tags": ["entry-point", "barrel", "wire-types"], "complexity": "simple"},
  {"id": "file:packages/sdk/protocol/src/transport.ts", "type": "file", "name": "transport.ts", "filePath": "packages/sdk/protocol/src/transport.ts", "summary": "字节流上的换行分隔 JSON-RPC 2.0 端点：带 id+method 为请求、仅 id 为响应、仅 method 为通知；坏行忽略、handler 失败变错误帧（缺 handler -32601、失败 -32603、无 handler 通知丢弃）；关闭/输入结束/输入错误使后续出站请求永久以首个失败拒绝，start 不重置该失败。", "tags": ["json-rpc", "line-transport", "bidirectional"], "complexity": "complex"},
  {"id": "class:packages/sdk/protocol/src/transport.ts:JsonRpcResponseError", "type": "class", "name": "JsonRpcResponseError", "filePath": "packages/sdk/protocol/src/transport.ts", "lineRange": [18, 28], "summary": "保留 wire code 与可选 data 的 JSON-RPC 错误响应异常。", "tags": ["error-type", "wire-preservation"], "complexity": "simple"},
  {"id": "class:packages/sdk/protocol/src/transport.ts:JsonRpcLineTransport", "type": "class", "name": "JsonRpcLineTransport", "filePath": "packages/sdk/protocol/src/transport.ts", "lineRange": [65, 276], "summary": "调用方拥有流上的行分隔端点：StringDecoder 处理跨块 UTF-8、request 关联 pending 等待者（AbortSignal 取消移除并忽略迟到响应）、notify 出站、flush 在关闭前冲刷写缓冲；start 挂监听、close 卸监听并拒绝 pending 但不销毁流。", "tags": ["transport", "pending-requests", "utf8-decoding"], "complexity": "complex"},
  {"id": "file:packages/sdk/protocol/src/types.ts", "type": "file", "name": "types.ts", "filePath": "packages/sdk/protocol/src/types.ts", "summary": "具名 wire 类型全集：InitializeParams/Result、SessionQuery/Prompt/Resume/Wait/WorkingDirectory 请求结果对、SdkEncodedImageBlock/SdkPromptContentBlock、用户问答请求/答案/取消、CommandExecution、SessionEvent/Status 通知、SubagentStarted/Finished 通知及 HarnessSdk 请求映射表（serverInfo.name 固定 deepseek-harness-sdk-runtime）。", "tags": ["type-definition", "wire-protocol", "request-map"], "complexity": "complex"},
  {"id": "config:packages/sdk/protocol/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/sdk/protocol/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"},
  {"id": "document:packages/sdk/server/README.md", "type": "document", "name": "README.md", "filePath": "packages/sdk/server/README.md", "summary": "dsh-sdk-jsonrpc-server 包 README：在 stdio 上服务 SDK wire 协议——每 sessionId 开一个会话、排队用户提示词、把全部 session 事件与 agent 状态迁移流回客户端；以 jsonrpc 插件身份挂进 Loader 组合，其余（agent/模型适配器/持久化/工具）由周围树供给；stdout 只承载 JSON-RPC 帧故组合不得有 stdout logger；shutdown 应答后处置根运行时并 exit 0。", "tags": ["documentation", "json-rpc-server", "stdio"], "complexity": "moderate"},
  {"id": "config:packages/sdk/server/package.json", "type": "config", "name": "package.json", "filePath": "packages/sdk/server/package.json", "summary": "@deepseek-ai/dsh-sdk-jsonrpc-server 包清单：SDK 服务器插件的依赖与导出。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "file:packages/sdk/server/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/sdk/server/src/index.ts", "summary": "函数插件 sdk-jsonrpc-server（inject agents/workingDirectory）：在配置流上建 JsonRpcLineTransport+HarnessSdkJsonRpcServer；initialize 是 SDK 就绪边界（await loader 完整树沉降），shutdown 应答写回后 flush→根 fiber dispose→exit(0) 共享一个 exit 任务防并发重复；effect 卸载时 server.shutdown+transport.close；提供 sdkSessionActivation ready。", "tags": ["plugin", "stdio-server", "lifecycle"], "complexity": "moderate", "languageNotes": "stdout 保留给协议帧；Config 含 input/output/exit 运行时测试钩子；具名导出无 default 以保 Loader unwrapExports 保留 name/inject/Config/apply。"},
  {"id": "function:packages/sdk/server/src/index.ts:apply", "type": "function", "name": "apply", "filePath": "packages/sdk/server/src/index.ts", "lineRange": [45, 104], "summary": "装配 transport+server 并挂 onRequest：initialize 先 await loader、shutdown 用 setImmediate 在应答写出后触发共享 exit 任务；effect 登记 transport.start 与卸载清理。", "tags": ["plugin-entry", "request-dispatch", "graceful-exit"], "complexity": "moderate"},
  {"id": "file:packages/sdk/server/src/query-activity.ts", "type": "file", "name": "query-activity.ts", "filePath": "packages/sdk/server/src/query-activity.ts", "summary": "命令准入活动观察器：QueryActivity 在原生命令启动前订阅（防丢快输入与完成），跟踪 commandId/user 输入/goal 创建-恢复-清除的首个终局、turn 结束原因与输入 idle，静默（quiescence）后产出 CommandExecution 结果；监听在完成/拒绝/关机时结束。", "tags": ["activity-observer", "goal-tracking", "quiescence"], "complexity": "complex"},
  {"id": "class:packages/sdk/server/src/query-activity.ts:QueryActivity", "type": "class", "name": "QueryActivity", "filePath": "packages/sdk/server/src/query-activity.ts", "lineRange": [9, 161], "summary": "单个命令的 SDK 完成观察者：session/event 过滤本 agent、嵌套原生命令保留外层调用完成身份、goal/change 记录 goalId 与首个终局（complete/paused→completed/aborted），close/check/finish 组装结果。", "tags": ["event-listeners", "goal-outcome", "completion"], "complexity": "complex"},
  {"id": "file:packages/sdk/server/src/query-content.ts", "type": "file", "name": "query-content.ts", "filePath": "packages/sdk/server/src/query-content.ts", "summary": "SDK 内容块校验与提取：queryContent 校验非空 contentBlocks（text 仅 type+text、编码图像限四 mime+可选名、附件引用须对象、其他 merge-extensible 内容走原提示词准入）、全空白文本拒绝；queryCommandImages 选出命令的编码图像并拒绝其他文本块混入。", "tags": ["validation", "content-blocks", "command-routing"], "complexity": "moderate"},
  {"id": "function:packages/sdk/server/src/query-content.ts:queryContent", "type": "function", "name": "queryContent", "filePath": "packages/sdk/server/src/query-content.ts", "lineRange": [12, 53], "summary": "在创建 Session 前校验路由用字段：数组非空、text/image 各自严格字段集、允许的图像 mime（png/jpeg/webp/gif）、非全空白。", "tags": ["validation", "untrusted-input"], "complexity": "moderate"},
  {"id": "function:packages/sdk/server/src/query-content.ts:queryCommandImages", "type": "function", "name": "queryCommandImages", "filePath": "packages/sdk/server/src/query-content.ts", "lineRange": [62, 74], "summary": "按原序提取命令输入中的编码图像；命令文本块之外只允许编码图像块，否则拒绝。", "tags": ["extraction", "command-input"], "complexity": "simple"},
  {"id": "file:packages/sdk/server/src/query-input.ts", "type": "file", "name": "query-input.ts", "filePath": "packages/sdk/server/src/query-input.ts", "summary": "SDK 的桌面文本输入识别：queryCommand 按定义身份识别紧凑显式的 permission/plan/goal（及无参 compact），规范名与中文别名跟随生效注册名；其余文本保持提示词，命令执行留在原生 registry。", "tags": ["command-recognition", "input-routing"], "complexity": "simple"},
  {"id": "function:packages/sdk/server/src/query-input.ts:queryCommand", "type": "function", "name": "queryCommand", "filePath": "packages/sdk/server/src/query-input.ts", "lineRange": [14, 27], "summary": "斜杠前缀解析命令名并 resolveCommand 对齐注册名，仅 permission（带参）/plan/goal（任意）与无参 compact 通过，产出原生兼容分隔符的命令行。", "tags": ["parsing", "builtin-identity"], "complexity": "simple"},
  {"id": "file:packages/sdk/server/src/server.ts", "type": "file", "name": "server.ts", "filePath": "packages/sdk/server/src/server.ts", "summary": "进程外 harness SDK 的 JSON-RPC 方法与通知实现：HarnessSdkJsonRpcServer 订阅 session/agent/subagent 生命周期直到关机（不支持重初始化），initialize 装配 LLM 适配器（DeepSeek API key 适配器+回退）、session/query 按输入路由原生命令或提示词（编码图像经 admitEncodedImages 持久化为附件）、AsyncLocalStorage 作用域 QueryActivity、subagent 启停通知、审批与用户问答桥、resume/wait/工作目录方法与 shutdown 处置。", "tags": ["json-rpc-server", "session-management", "lifecycle-subscription"], "complexity": "complex", "languageNotes": "durablePromptContent 把编码图像转附件引用（无附件存储即报错）；successStatus 按 maxTokensAsSuccess 把 max-tokens 终结映射为成功。"},
  {"id": "function:packages/sdk/server/src/server.ts:durablePromptContent", "type": "function", "name": "durablePromptContent", "filePath": "packages/sdk/server/src/server.ts", "lineRange": [57, 71], "summary": "把提示词中的编码图像块经 attachments 服务的 admitEncodedImages 持久化，原位替换为附件引用块。", "tags": ["image-admission", "attachment-refs"], "complexity": "simple"},
  {"id": "class:packages/sdk/server/src/server.ts:HarnessSdkJsonRpcServer", "type": "class", "name": "HarnessSdkJsonRpcServer", "filePath": "packages/sdk/server/src/server.ts", "lineRange": [89, 605], "summary": "核心服务器类：sessions/sessionCreations 双 Map 防并发建会话、commandTasks 集合、queryInvocation ALS 作用域活动、goal 生命周期、userQuestions 桥、llmFiber 适配器装载与 shutdown 任务化处置；handleRequest 分发 initialize/prompt/query/resume/wait/工作目录。", "tags": ["server-core", "rpc-dispatch", "concurrency"], "complexity": "complex"},
  {"id": "file:packages/sdk/server/src/user-questions.ts", "type": "file", "name": "user-questions.ts", "filePath": "packages/sdk/server/src/user-questions.ts", "summary": "共享 user-questions 缝的原生 SDK 适配器：SdkUserQuestionBridge 经 user-question/ask 反向请求宿主应答，abort 时通知 user-question.cancelled；parseHostAnswer 严格校验应答（每题恰一次、selected 标签数组、可选 custom），坏答案 BAD_ANSWER、取消 ASK_CANCELLED。", "tags": ["user-questions", "reverse-rpc", "validation"], "complexity": "moderate"},
  {"id": "class:packages/sdk/server/src/user-questions.ts:SdkUserQuestionBridge", "type": "class", "name": "SdkUserQuestionBridge", "filePath": "packages/sdk/server/src/user-questions.ts", "lineRange": [9, 58], "summary": "一个 SDK 传输的问答桥：初始化广告应答者后 enabled；user-questions/request 瀑布里对自有 agent 截流转发，close 停止准入并以 ASK_ABORTED 取消未决问题。", "tags": ["waterfall-listener", "cancellation"], "complexity": "moderate"},
  {"id": "function:packages/sdk/server/src/user-questions.ts:parseHostAnswer", "type": "function", "name": "parseHostAnswer", "filePath": "packages/sdk/server/src/user-questions.ts", "lineRange": [61, 78], "summary": "宿主应答入工具结果/审批决定前的不可信校验：cancelled 单键形态或 answers 数组（id/selected/custom 字段严格），题号集合与请求恰等。", "tags": ["validation", "untrusted-input"], "complexity": "moderate"},
  {"id": "config:packages/sdk/server/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/sdk/server/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"}
