{
 "nodes": [
  {"id": "file:packages/client/ui-settings-models/src/client/ApiKeyInput.tsx", "type": "file", "name": "ApiKeyInput.tsx", "filePath": "packages/client/ui-settings-models/src/client/ApiKeyInput.tsx", "summary": "只写凭据输入框：与密文会话文本同款显隐行为——仅非空草稿可揭示，换值重新掩蔽；autocomplete=\"new-password\" 阻止浏览器自动填充，存储的凭据永不回读进输入框。", "tags": ["react-component", "credential-input", "write-only"], "complexity": "simple"},
  {"id": "function:packages/client/ui-settings-models/src/client/ApiKeyInput.tsx:ApiKeyInput", "type": "function", "name": "ApiKeyInput", "filePath": "packages/client/ui-settings-models/src/client/ApiKeyInput.tsx", "lineRange": [24, 54], "summary": "渲染密码输入加眼睛切换按钮：revealed 状态只在草稿非空且值未变时保持，onChange 即重置揭示态；SVG 眼睛/划线眼图标内联。", "tags": ["react-component", "exported", "reveal-toggle"], "complexity": "simple"},
  {"id": "file:packages/client/ui-settings-models/src/client/ModelInputTypes.tsx", "type": "file", "name": "ModelInputTypes.tsx", "filePath": "packages/client/ui-settings-models/src/client/ModelInputTypes.tsx", "summary": "DeepSeek 与 pi-ai 目录编辑器共用的输入类型声明控件：Text/Image 复选框组，未覆写前显示继承类型；DeepSeek 侧关闭 Image 时连带删除 imagePixelBudget/imageMaxBytes（适配器拒绝无图像输入的图像限额）。", "tags": ["react-component", "model-editor", "checkbox-group"], "complexity": "simple"},
  {"id": "function:packages/client/ui-settings-models/src/client/ModelInputTypes.tsx:ModelInputTypes", "type": "function", "name": "ModelInputTypes", "filePath": "packages/client/ui-settings-models/src/client/ModelInputTypes.tsx", "lineRange": [32, 61], "summary": "渲染带 legend 的输入类型 fieldset：selected 取显式覆写→fallback→['text']，至少保留一项（唯一选中项禁用取消），按 field 名写入 inputModalities/input。", "tags": ["react-component", "exported", "input-modalities"], "complexity": "simple"},
  {"id": "file:packages/client/ui-settings-models/src/client/ModelReasoningEfforts.tsx", "type": "file", "name": "ModelReasoningEfforts.tsx", "filePath": "packages/client/ui-settings-models/src/client/ModelReasoningEfforts.tsx", "summary": "手声明 pi-ai 路由模型的推理级别编辑器：开关 + 每级别一行（级别 select 配 API 值输入），镜像适配器拒绝规则（Off 外级别必须有值、不能只剩 Off），行按存储序展示且 schema 未列出的存量键保留可选。", "tags": ["react-component", "reasoning-efforts", "model-editor", "validation"], "complexity": "complex"},
  {"id": "function:packages/client/ui-settings-models/src/client/ModelReasoningEfforts.tsx:withEfforts", "type": "function", "name": "withEfforts", "filePath": "packages/client/ui-settings-models/src/client/ModelReasoningEfforts.tsx", "lineRange": [52, 61], "summary": "替换模型行的已声明级别并保留其余字段：entries 为 undefined 时删除 reasoningEfforts 字段（手声明模型\"不推理\"的表达），否则按行序 Object.fromEntries 写回。", "tags": ["draft-mutation", "internal"], "complexity": "simple"},
  {"id": "function:packages/client/ui-settings-models/src/client/ModelReasoningEfforts.tsx:validateReasoningEfforts", "type": "function", "name": "validateReasoningEfforts", "filePath": "packages/client/ui-settings-models/src/client/ModelReasoningEfforts.tsx", "lineRange": [77, 85], "summary": "写前镜像 pi-ai 的 reasoningEfforts 拒绝规则：逐模型行检查，任一值不合法返回 modelReasoningValueRequired，只剩 Off 级别返回 modelReasoningNeedsLevel，让卡片按行报错而非写入时失败。", "tags": ["validation", "exported", "pre-write-check"], "complexity": "simple"},
  {"id": "function:packages/client/ui-settings-models/src/client/ModelReasoningEfforts.tsx:ModelReasoningEfforts", "type": "function", "name": "ModelReasoningEfforts", "filePath": "packages/client/ui-settings-models/src/client/ModelReasoningEfforts.tsx", "lineRange": [110, 247], "summary": "渲染推理级别组：开关从 off/low/medium/high 初始行起步；级别切换仅在两个思考级别间携带自定义值（进出 Off 或值仍拼写为旧级别名则重置）；焦点字段保留自己的未完成文本，行以位置为身份避免重挂载丢键盘焦点。", "tags": ["react-component", "exported", "row-editor"], "complexity": "complex"},
  {"id": "file:packages/client/ui-settings-models/src/client/ModelRow.tsx", "type": "file", "name": "ModelRow.tsx", "filePath": "packages/client/ui-settings-models/src/client/ModelRow.tsx", "summary": "两套适配器目录编辑器共用的模型行：拖拽柄排序（拖预览+上下箭头键）、窄行展开区放显示名、展开区含容量字段/输入类型/推理级别；dataTransfer 用 application/x-dsh-model-order 私有类型。", "tags": ["react-component", "model-editor", "drag-reorder"], "complexity": "complex"},
  {"id": "function:packages/client/ui-settings-models/src/client/ModelRow.tsx:ModelRow", "type": "function", "name": "ModelRow", "filePath": "packages/client/ui-settings-models/src/client/ModelRow.tsx", "lineRange": [56, 187], "summary": "渲染一个可展开模型条目：rowHalf 按指针上下半判定插入侧，拖拽走 order 回调（onStart/onOver/onDrop/onMove），name 字段聚焦自动展开，删除按钮 danger 样式；展开区挂 ModelInputTypes 与条件挂 ModelReasoningEfforts。", "tags": ["react-component", "exported", "dnd", "expandable-row"], "complexity": "complex"},
  {"id": "file:packages/client/ui-settings-models/src/client/protocol-label.ts", "type": "file", "name": "protocol-label.ts", "filePath": "packages/client/ui-settings-models/src/client/protocol-label.ts", "summary": "协议产品名映射：选择器显示 openai-completions 等标识符的产品名（OpenAI Chat Completions 等），存储值仍是 schema 标识符；本页未命名的后加协议原样显示标识符。", "tags": ["utility", "label-mapping"], "complexity": "simple"},
  {"id": "function:packages/client/ui-settings-models/src/client/protocol-label.ts:protocolLabel", "type": "function", "name": "protocolLabel", "filePath": "packages/client/ui-settings-models/src/client/protocol-label.ts", "lineRange": [24, 27], "summary": "按 schema 标识符取选择器文案：PROTOCOL_LABEL_KEYS 命中走词典 t()，未命中回退标识符本身（settings.yaml 需要的拼写）。", "tags": ["utility", "exported"], "complexity": "simple"},
  {"id": "file:packages/client/ui-settings-models/src/client/useModelRows.ts", "type": "file", "name": "useModelRows.ts", "filePath": "packages/client/ui-settings-models/src/client/useModelRows.ts", "summary": "模型行本地状态 hook：行身份 key 与编辑中容量文本随草稿移动/删除保持，拖拽目标态（before/after）、键盘移动与 forget/reset 动作；编辑模型 ID 不换行控件。", "tags": ["react-hook", "row-state", "dnd"], "complexity": "moderate"},
  {"id": "function:packages/client/ui-settings-models/src/client/useModelRows.ts:useModelRows", "type": "function", "name": "useModelRows", "filePath": "packages/client/ui-settings-models/src/client/useModelRows.ts", "lineRange": [48, 110], "summary": "维护行状态与模型草稿的对齐：行数不匹配时同步补建，move 同时重排行状态并回调 onChange 重排模型数组，drop 按 half 折算插入位并结束拖拽。", "tags": ["react-hook", "exported", "dnd"], "complexity": "moderate"},
  {"id": "file:packages/client/ui-settings-models/src/onboarding-config.ts", "type": "file", "name": "onboarding-config.ts", "filePath": "packages/client/ui-settings-models/src/onboarding-config.ts", "summary": "Host/Client 两半共享的页面引导配置：schemastery z.object 校验 credentialOnboarding（默认 true），ONBOARDING_CONFIG_GLOBAL 是只载公共引导项的页面全局键。", "tags": ["config-schema", "schemastery", "onboarding"], "complexity": "simple"},
