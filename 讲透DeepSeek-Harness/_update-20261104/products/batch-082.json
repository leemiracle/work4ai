  {"id": "document:packages/client/ui-settings-plugins/README.md", "type": "document", "name": "README.md", "filePath": "packages/client/ui-settings-plugins/README.md", "summary": "ui-settings-plugins 包参考文档：Built-in plugins 设置节是纯壳——只拥有导航入口与 tab 行，每个 tab 由其它插件注册（清单页是唯一在册 tab）；声明 settings.plugins.tab 根列表插槽，单项贡献渲染为页面本身。", "tags": ["documentation", "package-reference", "settings-section", "slot-owner"], "complexity": "simple"},
  {"id": "config:packages/client/ui-settings-plugins/package.json", "type": "config", "name": "package.json", "filePath": "packages/client/ui-settings-plugins/package.json", "summary": "@deepseek-ai/dsh-client-ui-settings-plugins 包清单：仅注入 locale/ui-settings 两个协作面。", "tags": ["configuration", "package-manifest", "client-plugin"], "complexity": "simple"},
