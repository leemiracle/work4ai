 "nodes": [
  {"id": "file:packages/client/file-upload/src/http-route.ts", "type": "file", "name": "http-route.ts", "filePath": "packages/client/file-upload/src/http-route.ts", "summary": "Connection fetch 注册表上的认证原始字节上传路由：handleFileUploadHttp 仅收 POST+application/octet-stream，sessionId 必填、可选 name/mediaType 查询参数，mediaType 存在则暂存为提示图像否则逐字存储；错误经 remoteErrorOf 归一为 JSON 结果（一律 200+no-store）。", "tags": ["http-route", "streamed-intake", "validation"], "complexity": "moderate"},
  {"id": "function:packages/client/file-upload/src/http-route.ts:handleFileUploadHttp", "type": "function", "name": "handleFileUploadHttp", "filePath": "packages/client/file-upload/src/http-route.ts", "lineRange": [23, 72], "summary": "处理单条认证上传请求：方法/媒体类型/sessionId 校验后把 request.body 逐块流转给 uploadStream/uploadImageStream，异常归一 ok/error JSON。", "tags": ["request-handling", "streaming"], "complexity": "moderate"},
  {"id": "file:packages/client/file-upload/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/client/file-upload/src/index.ts", "summary": "Host 文件上传服务（FileUploads 为 TypertRemoteService 子类，inject agents/attachments/commands/connection，ctx.fileUploads）：流式接收+按各接收 Agent 精确 Session 键控暂存回执；PromptFileBindingGuard 回滚保护在提示词提交前恢复回执原主；@Remote 方法+Connection fetch 路由双入口，readAtMost 有界读取防超大暂存。", "tags": ["service-provider", "staged-receipts", "typert-remote"], "complexity": "complex", "languageNotes": "agentResolution 用普通对象包 resolver——经 ctx.fileUploads 调用时 Cordis 对函数属性读取每次返回新代理，=== 对已注册 resolver 恒 false；命令只认文件回执、图像回执对命令未知。"},
  {"id": "class:packages/client/file-upload/src/index.ts:PromptFileBindingGuard", "type": "class", "name": "PromptFileBindingGuard", "filePath": "packages/client/file-upload/src/index.ts", "lineRange": [41, 55], "summary": "回执绑定守卫：commit 后 dispose 为空操作，未 commit 即 dispose 触发 rollback 恢复回执原属（队列或历史观察退休前保留绑定）。", "tags": ["rollback-guard", "disposable"], "complexity": "simple"},
  {"id": "class:packages/client/file-upload/src/index.ts:FileUploads", "type": "class", "name": "FileUploads", "filePath": "packages/client/file-upload/src/index.ts", "lineRange": [58, 307], "summary": "Host 上传服务核心：stagedFiles WeakMap<Session,Map> 键控暂存、registerAgentResolver 解析/恢复普通 Agent、upload/uploadStream/uploadImageStream 三入口、bindPrompt/retirePrompt 管理回执生命周期、store/stage 落附件存储、命令回执解析器注册。", "tags": ["service-provider", "receipt-lifecycle", "agent-scoping"], "complexity": "complex"},
  {"id": "function:packages/client/file-upload/src/index.ts:readAtMost", "type": "function", "name": "readAtMost", "filePath": "packages/client/file-upload/src/index.ts", "lineRange": [310, 332], "summary": "从异步迭代读至多 maxBytes 字节：超限即停止读取并报告，防超大暂存耗尽内存。", "tags": ["bounded-read", "byte-cap"], "complexity": "simple"},
  {"id": "function:packages/client/file-upload/src/index.ts:fileNotStaged", "type": "function", "name": "fileNotStaged", "filePath": "packages/client/file-upload/src/index.ts", "lineRange": [334, 340], "summary": "构造“回执未暂存”的 Remote 错误工厂。", "tags": ["error-factory"], "complexity": "simple"},
