  {"id": "file:packages/client/product-analytics/src/client/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/client/product-analytics/src/client/index.ts", "summary": "桌面渲染进程分析发送器（浏览器应用无采集能力）：DesktopAnalytics（Service 子类，ctx.productAnalytics，inject remote/remote.productAnalytics）经 Remote report 提交事件、经 $stream 订阅 Host 策略流控 enabled；track 未启用即弃、提交失败静默不打断交互；dshDesktop 全局不在则不订阅。", "tags": ["service-provider", "analytics", "policy-stream"], "complexity": "moderate"},
  {"id": "class:packages/client/product-analytics/src/client/index.ts:DesktopAnalytics", "type": "class", "name": "DesktopAnalytics", "filePath": "packages/client/product-analytics/src/client/index.ts", "lineRange": [17, 57], "summary": "桌面分析服务：构造建 submit 闭包（RPC 分派留在 provider context）并订阅产品分析策略流，enabled 跟随帧值，track 构造事件即发不留存。", "tags": ["service-provider", "stream-subscription"], "complexity": "moderate"},
