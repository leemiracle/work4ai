  {"id": "file:packages/client/file-upload/src/types.ts", "type": "file", "name": "types.ts", "filePath": "packages/client/file-upload/src/types.ts", "summary": "浏览器安全的暂存上传请求与回执类型：EncodedFileUploadRequest（Remote 回退的 base64 规范编码）、Branded FileUploadReceiptId（仅接收 Agent 作用域内有效的每上传授权）、FileUploadValue/ImageUploadValue（回执+持久附件引用）、StagedAttachment。", "tags": ["type-definition", "branded-id", "browser-safe"], "complexity": "simple"},
