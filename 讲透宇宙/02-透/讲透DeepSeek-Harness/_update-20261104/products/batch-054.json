{
 "nodes": [
  {"id": "document:packages/typert/README.md", "type": "document", "name": "README.md", "filePath": "packages/typert/README.md", "summary": "typert 包组 README：Typert API Gateway 家族地图——build 时 generator 把源类型声明变成编译器无关模型与运行时工件，registry 运行时存取，loader 在 Loader 组合中自动登记，protocol 提供 Remote 调用声明（装饰器/wire 描述符/codec/provider 契约）。", "tags": ["documentation", "package-group", "typert", "api-gateway"], "complexity": "simple"},
  {"id": "document:packages/typert/generator/README.md", "type": "document", "name": "README.md", "filePath": "packages/typert/generator/README.md", "summary": "dsh-typert-generator 包 README：把公开 TypeScript 类型转成构建工件与编译器无关模型；包经 ./typert 与可选 ./client/typert 导出选配，无法正确表示的声明/publish 列表/Remote 导出/Zod 投影一律拒绝；仅构建期运行，永不进活 agent 会话。", "tags": ["documentation", "type-generation", "build-time"], "complexity": "moderate"},
  {"id": "config:packages/typert/generator/package.json", "type": "config", "name": "package.json", "filePath": "packages/typert/generator/package.json", "summary": "@deepseek-ai/dsh-typert-generator 包清单：类型图生成器的依赖与导出（含 artifact-files/worker 子路径）。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "file:packages/typert/generator/src/artifact-files.ts", "type": "file", "name": "artifact-files.ts", "filePath": "packages/typert/generator/src/artifact-files.ts", "summary": "Typert 生成工件的包内落盘：tsdown 插件与独立 workspace 生成共用，保证同工件两路写出同字节——每 face 写 typert.<face>.js/.d.ts，含 Remote 方法的工件额外写三个 typert.remote-client.* 文件；无 Remote 的 Host 工件清除旧 Remote 客户端残留。", "tags": ["artifact-writing", "idempotent-output", "typert"], "complexity": "simple"},
  {"id": "function:packages/typert/generator/src/artifact-files.ts:writePackageArtifacts", "type": "function", "name": "writePackageArtifacts", "filePath": "packages/typert/generator/src/artifact-files.ts", "lineRange": [29, 46], "summary": "把一个包的工件逐文件写入 lib/：face 命名的 js/dts 对，Remote 客户端三件套按需写并按 host face 清残留；逐文件写意味着失败可留下部分替换。", "tags": ["file-writing", "artifact-layout"], "complexity": "simple"},
  {"id": "function:packages/typert/generator/src/artifact-files.ts:writeWorkspaceArtifacts", "type": "function", "name": "writeWorkspaceArtifacts", "filePath": "packages/typert/generator/src/artifact-files.ts", "lineRange": [57, 59], "summary": "按工件顺序把一次 workspace 生成遍写到各自包（packageRoot 相对 root），失败即停：前面的包保留新文件、后面的保留旧文件。", "tags": ["workspace-pass", "artifact-writing"], "complexity": "simple"},
  {"id": "file:packages/typert/generator/src/build-output-guard.ts", "type": "file", "name": "build-output-guard.ts", "filePath": "packages/typert/generator/src/build-output-guard.ts", "summary": "构建产物守卫：检测被分析 face 程序加载了工作区包 lib/ 产物（findBuildOutputLoads，重解析 import 找加载者与对应源文件）与解析为空的工作区导入（findUnresolvedWorkspaceImports，经 node_modules 链接识别包并从 exports types 条件推导源文件）——保证 Typert 只读源码、结果不依赖包是否编译过。", "tags": ["build-output-detection", "module-resolution", "typescript-api"], "complexity": "complex", "languageNotes": "BuildOutputClassifier 用 realpathSync.native 归一符号链接与 Windows 8.3 短名，报告路径按调用方 root 拼写；未解析导入的源推导把 ./lib/types/*.d.ts 映射回 src/*.ts/.tsx。"},
  {"id": "function:packages/typert/generator/src/build-output-guard.ts:findBuildOutputLoads", "type": "function", "name": "findBuildOutputLoads", "filePath": "packages/typert/generator/src/build-output-guard.ts", "lineRange": [44, 67], "summary": "收集程序中位于工作区包 lib/ 下的文件，再对每个非产物工作区文件 preProcess+resolveModuleName 重解析 import 找出加载者；仅在存在产物时付出额外开销，返回按路径排序的 BuildOutputLoad 列表。", "tags": ["detection", "importer-resolution"], "complexity": "moderate"},
  {"id": "function:packages/typert/generator/src/build-output-guard.ts:findUnresolvedWorkspaceImports", "type": "function", "name": "findUnresolvedWorkspaceImports", "filePath": "packages/typert/generator/src/build-output-guard.ts", "lineRange": [91, 116], "summary": "列出命名工作区包却解析失败的非相对导入：从导入者目录向上找 node_modules 链接确认包在工作区内，再按 exports types 条件推导子路径源文件；模块解析缓存复用。", "tags": ["unresolved-imports", "workspace-packages", "exports-mapping"], "complexity": "moderate"},
  {"id": "class:packages/typert/generator/src/build-output-guard.ts:BuildOutputClassifier", "type": "class", "name": "BuildOutputClassifier", "filePath": "packages/typert/generator/src/build-output-guard.ts", "lineRange": [150, 225], "summary": "按真实路径分类程序文件：canonical（realpath 缓存）、display（按调用方 root 拼写）、isWorkspaceFile（root 内且不在 node_modules）、isBuildOutput（包内 lib/ 下）、sourceFor（lib/types .d.ts 反推 src/.ts）、linkedWorkspacePackage（沿目录找 node_modules 链接目标）。", "tags": ["path-classification", "symlink-normalization", "memoization"], "complexity": "complex"},
  {"id": "file:packages/typert/generator/src/tool-schema.ts", "type": "file", "name": "tool-schema.ts", "filePath": "packages/typert/generator/src/tool-schema.ts", "summary": "把已解析类型无损投影进 dsh-tools 强制的工具 schema 子集（keyword/literal/array/object/reference/union 递归，对象成员过滤 static/非 public/symbol computed，索引签名仅允许 string 键+无约束 JSON 值）；子集无法无损表达即抛 ToolSchemaError，调用方按缺投影上报而非给弱化 schema。", "tags": ["schema-projection", "tool-schema", "lossless-check"], "complexity": "complex", "languageNotes": "递归 active 集合检测循环引用；union 分支两两 disjoint 校验（对象经 required 判别属性的字面量互斥合并），标量同型 const/enum 合并去重。"},
  {"id": "function:packages/typert/generator/src/tool-schema.ts:projectToolSchema", "type": "function", "name": "projectToolSchema", "filePath": "packages/typert/generator/src/tool-schema.ts", "lineRange": [34, 131], "summary": "对类型图节点递归投影：reference 展开无泛型参数的声明（alias 透传/成员对象，extends 未解析即拒）；optional 顶导出剔除 undefined 分支；闭包 object/union 处理成员与分支合并。", "tags": ["recursion", "schema-building", "type-projection"], "complexity": "complex"},
  {"id": "class:packages/typert/generator/src/tool-schema.ts:ToolSchemaError", "type": "class", "name": "ToolSchemaError", "filePath": "packages/typert/generator/src/tool-schema.ts", "lineRange": [7, 9], "summary": "表示已解析 codec 的类型无法在不弱化约束下进入工具 schema 子集的错误类型。", "tags": ["error-type", "schema-limit"], "complexity": "simple"},
  {"id": "file:packages/typert/generator/src/worker.ts", "type": "file", "name": "worker.ts", "filePath": "packages/typert/generator/src/worker.ts", "summary": "workspace 模式 Typert 生成的 Worker Thread 入口：从 workerData 解析请求（root/faces/options 三重校验），new WorkspaceTypertGenerator 生成全部显式贡献者，恰好 postMessage 一条 artifacts 或 failure 响应后退出；非 Worker 环境直接抛错。", "tags": ["worker-thread", "entry-point", "generation"], "complexity": "simple"},
  {"id": "function:packages/typert/generator/src/worker.ts:respond", "type": "function", "name": "respond", "filePath": "packages/typert/generator/src/worker.ts", "lineRange": [49, 63], "summary": "worker 主体：解析请求并生成贡献者，成功返回 artifacts，任何异常降级为携带 name/message/stack 的 failure 响应。", "tags": ["worker-body", "error-capture"], "complexity": "simple"},
  {"id": "config:packages/typert/generator/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/typert/generator/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"},
  {"id": "document:packages/typert/loader/README.md", "type": "document", "name": "README.md", "filePath": "packages/typert/loader/README.md", "summary": "dsh-typert-loader 包 README：挂载后每个 Loader 组合中的包自动向运行时 registry 贡献生成 Typert 反射与 schema 工厂，卸载即撤回；无生成导出的包被跳过故加进任何组合都安全；显式 packages 列表覆盖嵌套 Loader 项；Node-only 且需 config-tree 解析锚。", "tags": ["documentation", "loader-integration", "registry"], "complexity": "moderate"},
  {"id": "config:packages/typert/loader/package.json", "type": "config", "name": "package.json", "filePath": "packages/typert/loader/package.json", "summary": "@deepseek-ai/dsh-typert-loader 包清单：Loader 集成插件的依赖与导出。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "config:packages/typert/loader/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/typert/loader/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"},
  {"id": "document:packages/typert/protocol/README.md", "type": "document", "name": "README.md", "filePath": "packages/typert/protocol/README.md", "summary": "dsh-typert-protocol 包 README：业务包用 @Remote/@RemoteScope 标注 Host 方法、绑定 wire 命名空间、经 merge-extensible 协议映射关联 Host 对象与作用域 Context；生成工件/Host Gateway/Client API 共用调用描述符、codec 与 provider 契约；调用所有值把清理权转移给 Gateway 而不加引用计数；本包不注册 Cordis 服务。", "tags": ["documentation", "remote-protocol", "decorators"], "complexity": "moderate"},
  {"id": "config:packages/typert/protocol/package.json", "type": "config", "name": "package.json", "filePath": "packages/typert/protocol/package.json", "summary": "@deepseek-ai/dsh-typert-protocol 包清单：Remote 调用协议的依赖与导出（principal/remote-access/remote-info 等子路径）。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "file:packages/typert/protocol/src/json-value.ts", "type": "file", "name": "json-value.ts", "filePath": "packages/typert/protocol/src/json-value.ts", "summary": "所有 Remote 载体共享的无损 JSON 校验（Client 句柄入队前、Gateway wire 与无 codec 上行边界、进程内 mock）：visitJsonValue 拒绝环、非普通原型、符号键、不可枚举属性、非有限数与 -0；isRemoteUplinkItem 额外放行顶层 undefined。", "tags": ["json-validation", "lossless-transport", "boundary-check"], "complexity": "moderate"},
  {"id": "function:packages/typert/protocol/src/json-value.ts:isRemoteJsonValue", "type": "function", "name": "isRemoteJsonValue", "filePath": "packages/typert/protocol/src/json-value.ts", "lineRange": [12, 14], "summary": "判断值能否无损过 JSON 传输（无强制转换与遗漏）。", "tags": ["validation", "json"], "complexity": "simple"},
  {"id": "function:packages/typert/protocol/src/json-value.ts:isRemoteUplinkItem", "type": "function", "name": "isRemoteUplinkItem", "filePath": "packages/typert/protocol/src/json-value.ts", "lineRange": [23, 25], "summary": "上行项校验：无损 JSON 值或顶层 undefined（wire 以无 value 的 item 帧承载），嵌套 undefined/NaN/无穷仍拒。", "tags": ["validation", "uplink"], "complexity": "simple"},
  {"id": "file:packages/typert/protocol/src/owned-value.ts", "type": "file", "name": "owned-value.ts", "filePath": "packages/typert/protocol/src/owned-value.ts", "summary": "同步 Client Context resolver 返回的调用所有值：TYPERT_OWNED_VALUE（Symbol.for 共享身份）标记的 Disposable 包装，release 至多一次幂等调用，调用与回复结算后释放；跨独立打包的 provider 与 Gateway 共享同一标记。", "tags": ["ownership-transfer", "disposable", "shared-symbol"], "complexity": "simple"},
  {"id": "function:packages/typert/protocol/src/owned-value.ts:typertOwnedValue", "type": "function", "name": "typertOwnedValue", "filePath": "packages/typert/protocol/src/owned-value.ts", "lineRange": [18, 29], "summary": "把借用载荷与一次性同步释放闭包包成调用所有值：active 标志保证 dispose 幂等。", "tags": ["factory", "disposable"], "complexity": "simple"},
  {"id": "function:packages/typert/protocol/src/owned-value.ts:isTypertOwnedValue", "type": "function", "name": "isTypertOwnedValue", "filePath": "packages/typert/protocol/src/owned-value.ts", "lineRange": [36, 39], "summary": "以共享标记识别调用所有值。", "tags": ["type-guard", "shared-marker"], "complexity": "simple"},
  {"id": "file:packages/typert/protocol/src/principal.ts", "type": "file", "name": "principal.ts", "filePath": "packages/typert/protocol/src/principal.ts", "summary": "读取当前 Remote 调用的非 owner 调用方身份：owner 与 Remote 调用外的可信进程内代码返回 undefined，供生产者记录在持久输出上。", "tags": ["principal", "caller-identity", "authorization"], "complexity": "simple"},
  {"id": "function:packages/typert/protocol/src/principal.ts:principalOf", "type": "function", "name": "principalOf", "filePath": "packages/typert/protocol/src/principal.ts", "lineRange": [14, 17], "summary": "从 ctx.invocation 的 peer.principal 取调用方身份，owner 态归一为 undefined。", "tags": ["principal", "normalization"], "complexity": "simple"},
  {"id": "file:packages/typert/protocol/src/remote-access.ts", "type": "file", "name": "remote-access.ts", "filePath": "packages/typert/protocol/src/remote-access.ts", "summary": "Remote 访问控制资源类型：内置无身份 global 资源 + TypertResourceMap 声明的每身份资源；资源彼此独立，访问其一不意味访问其他；id 为 wire 值，先读后校验。", "tags": ["type-definition", "access-control", "resource-model"], "complexity": "simple", "languageNotes": "declare-merge 键模式：本编译单元资源映射为空时 TypertResourceKind 呈 never，oxlint 用注释豁免冗余类型成分规则。"},
  {"id": "file:packages/typert/protocol/src/remote-info.ts", "type": "file", "name": "remote-info.ts", "filePath": "packages/typert/protocol/src/remote-info.ts", "summary": "生成 Remote 定义的惰性装配（调用方自带 Zod，无运行时 import）：RemoteInfo 首访问才建 descriptor/method 索引，NamedInput 按需建 strict/loose 命名输入 Zod schema 与 JSON Schema 投影，ResultValue 包装结果 codec 并缓存带 description 的投影。", "tags": ["lazy-assembly", "zod", "remote-definitions"], "complexity": "complex"},
  {"id": "function:packages/typert/protocol/src/remote-info.ts:createTypertRemoteInfo", "type": "function", "name": "createTypertRemoteInfo", "filePath": "packages/typert/protocol/src/remote-info.ts", "lineRange": [28, 30], "summary": "以编译器产出的方法事实与 Zod 运行时构造惰性、可挂载的 RemoteInfo 实例（无注册与传输副作用）。", "tags": ["factory", "lazy"], "complexity": "simple"},
  {"id": "class:packages/typert/protocol/src/remote-info.ts:RemoteInfo", "type": "class", "name": "RemoteInfo", "filePath": "packages/typert/protocol/src/remote-info.ts", "lineRange": [32, 83], "summary": "按端点惰性建索引：namespace/method 拆分 endpoint、参数补 wire 名、direct 调用生成 input（strict 双缓存）与 invoke（按 wire 名取参、保留 Gateway 挂载检查与作用域接收者策略）。", "tags": ["index-building", "invocation-descriptor", "lazy-init"], "complexity": "complex"},
  {"id": "class:packages/typert/protocol/src/remote-info.ts:NamedInput", "type": "class", "name": "NamedInput", "filePath": "packages/typert/protocol/src/remote-info.ts", "lineRange": [100, 140], "summary": "命名输入 codec：zod.strictObject 按 wire 名组装（json 源且接受 undefined 的参数 optional，其余 nonoptional），jsonSchema 投影任一参数缺 JSON Schema 即报错并缓存。", "tags": ["input-codec", "zod-schema", "json-schema"], "complexity": "moderate"},
  {"id": "class:packages/typert/protocol/src/remote-info.ts:ResultValue", "type": "class", "name": "ResultValue", "filePath": "packages/typert/protocol/src/remote-info.ts", "lineRange": [142, 161], "summary": "结果 codec 包装：委托原 spec 的 mode/create/decode/encode 等，仅缓存合并 description 的 jsonSchema 投影。", "tags": ["codec-wrapper", "projection-cache"], "complexity": "simple"},
  {"id": "function:packages/typert/protocol/src/remote-info.ts:isTypertRemoteMethod", "type": "function", "name": "isTypertRemoteMethod", "filePath": "packages/typert/protocol/src/remote-info.ts", "lineRange": [90, 94], "summary": "把 Registry descriptor 收窄为生成的 direct 方法能力（direct 调用+strict 结果+input/invoke 均为函数）。", "tags": ["type-guard", "descriptor-narrowing"], "complexity": "simple"},
  {"id": "config:packages/typert/protocol/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/typert/protocol/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"},
  {"id": "document:packages/typert/registry/README.md", "type": "document", "name": "README.md", "filePath": "packages/typert/registry/README.md", "summary": "dsh-typert-registry 包 README：生成工件运行时可查——每包反射/惰性 Zod schema 工厂/Remote 调用描述符存于稳定键下，首次请求才物化缓存；登记原子且 fiber 作用域（整体落地或全不落地，组件卸载自动撤回）；同服务还承载 Remote 调用解析用的查找与作用域 Context provider 注册表。", "tags": ["documentation", "registry", "fiber-scoped"], "complexity": "moderate"},
  {"id": "config:packages/typert/registry/package.json", "type": "config", "name": "package.json", "filePath": "packages/typert/registry/package.json", "summary": "@deepseek-ai/dsh-typert-registry 包清单：运行时注册表的依赖与导出。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "config:packages/typert/registry/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/typert/registry/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"}
 ],
