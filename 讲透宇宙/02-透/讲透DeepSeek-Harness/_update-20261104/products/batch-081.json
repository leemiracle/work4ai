  {"id": "file:packages/client/ui-settings-general/src/client/DesktopUpdateIndicator.tsx", "type": "file", "name": "DesktopUpdateIndicator.tsx", "filePath": "packages/client/ui-settings-general/src/client/DesktopUpdateIndicator.tsx", "summary": "Desktop 更新状态展示：updateCopy 把 preload 语义相位/版本/进度/分类失败映射为本地化文案；指示器按钮与折叠侧栏徽标共享几何与 brand-blue 配色，连接反馈优先（安装期例外）。", "tags": ["react-component", "desktop-update", "status-indicator"], "complexity": "complex"},
