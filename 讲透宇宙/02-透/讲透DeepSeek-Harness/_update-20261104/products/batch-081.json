  {"id": "file:packages/client/ui-settings-general/src/client/desktop-update-source.ts", "type": "file", "name": "desktop-update-source.ts", "filePath": "packages/client/ui-settings-general/src/client/desktop-update-source.ts", "summary": "更新观察源：DesktopUpdateSource 跨展开/折叠两处侧栏控件共享一条 preload 订阅，普通浏览器无 bridge 时静默保持 failed 视图。", "tags": ["observable-store", "desktop-update", "data-source"], "complexity": "simple"},
  {"id": "class:packages/client/ui-settings-general/src/client/desktop-update-source.ts:DesktopUpdateSource", "type": "class", "name": "DesktopUpdateSource", "filePath": "packages/client/ui-settings-general/src/client/desktop-update-source.ts", "lineRange": [6, 43], "summary": "可选 Electron 更新桥的客户端观察者：订阅推送覆盖初值 status 轮询，open() 在 opening/进行中相位时合并重复点击到同一 shell 操作，失败只置 failed 不伪造状态。", "tags": ["observable-store", "ipc-bridge", "exported"], "complexity": "moderate"},
