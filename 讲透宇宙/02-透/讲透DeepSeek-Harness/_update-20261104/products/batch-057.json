  {"id": "function:packages/host/open-in-app/src/icons.ts:extractAppIcon", "type": "function", "name": "extractAppIcon", "filePath": "packages/host/open-in-app/src/icons.ts", "lineRange": [143, 161], "summary": "按平台分发提取：linux 走 desktopId、macOS 走 app-bundle、Windows 走 executable 图标源，返回字节与媒体类型。", "tags": ["dispatch", "icon-source"], "complexity": "simple"},
  {"id": "file:packages/host/open-in-app/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/host/open-in-app/src/index.ts", "summary": "open-in-app host 半体（函数插件，inject webServer/connection/subprocess）：三条路由——apps 列已验证目录 id、icon 每应用 PNG、open 启动端点（浏览器分体按钮 POST 目标）。安全单一归宿：每路由先问 connection.requestRejection（Host/Origin 栅防 DNS rebinding+登录 cookie），open 路由再在 wire 上校验 JSON 体（64KiB 上限、字符串字段、目录 id 已解析、绝对路径且为存在目录）；目录惰性解析一次成 map，ENOENT 启动失效单条目重解析一次。", "tags": ["plugin", "http-routes", "security-fence", "lazy-resolution"], "complexity": "complex"},
  {"id": "function:packages/host/open-in-app/src/index.ts:readBoundedBody", "type": "function", "name": "readBoundedBody", "filePath": "packages/host/open-in-app/src/index.ts", "lineRange": [107, 121], "summary": "按 64KiB 上限收集请求体：超限先 drain 剩余流再返回 null（拒绝是可读响应而非掐断 socket）。", "tags": ["bounded-body", "wire-safety"], "complexity": "simple"},
  {"id": "function:packages/host/open-in-app/src/index.ts:apply", "type": "function", "name": "apply", "filePath": "packages/host/open-in-app/src/index.ts", "lineRange": [138, 311], "summary": "装配三条路由：catalogInternals 注入 SSH 事实与 composition 的 PATH 解析器，webServer 注册 apps/icon/open；open 体校验+目录 stat 后 launchResolved，missing 结果触发单条目重解析与原位替换。", "tags": ["plugin-entry", "route-registration", "launch-flow"], "complexity": "complex"},
  {"id": "file:packages/host/open-in-app/src/internals.ts", "type": "file", "name": "internals.ts", "filePath": "packages/host/open-in-app/src/internals.ts", "summary": "测试缝：源码级测试在插件激活前注入 catalog 事实（OpenInAppInternals），生产保持空默认。", "tags": ["test-seam", "injection"], "complexity": "simple"},
  {"id": "file:packages/host/open-in-app/src/resolver.ts", "type": "file", "name": "resolver.ts", "filePath": "packages/host/open-in-app/src/resolver.ts", "summary": "open-in-app 目录的平台解析：每个条目的 locator 链解析为本机实持的已验证启动器（十种 locator：fixed/app/xcode/cli/file/scan/app-paths/install-record/github-desktop/desktop），一次解析产出路由服务的 map 使点击永不重跑探测；Windows 注册表（reg.exe query /s，App Paths+Uninstall 三根）单遍惰性读一次；launchDetachedApp 分离启动子进程带凭据擦洗环境与早失败观察窗，shell-open 走系统 open 动词。", "tags": ["platform-resolution", "locators", "registry-parsing", "detached-launch"], "complexity": "complex", "languageNotes": "reg.exe 值列按 REG_* 类型 token 匹配（默认值标记会本地化为 (默认)）；版本目录用 localeCompare numeric 排序（2024.1.10 > 2024.1.9）；launch 成功与进程退出解耦——观察窗内非零退出才拒，窗关时仍在跑的 child unref 计为启动。"},
  {"id": "function:packages/host/open-in-app/src/resolver.ts:launchDetachedApp", "type": "function", "name": "launchDetachedApp", "filePath": "packages/host/open-in-app/src/resolver.ts", "lineRange": [74, 96], "summary": "分离启动一个 GUI 适配器：scrubbedParentEnv+适配器显式 env、stdio ignore、detached+unref 活过 dsh；观察窗内 spawn 失败或非零退出才拒，exit 0 或窗关即计启动。", "tags": ["detached-spawn", "credential-scrubbing", "watch-window"], "complexity": "moderate"},
  {"id": "function:packages/host/open-in-app/src/resolver.ts:resolveInternals", "type": "function", "name": "resolveInternals", "filePath": "packages/host/open-in-app/src/resolver.ts", "lineRange": [135, 151], "summary": "补全可注入平台事实为运行态；resolveExecutable 无默认（由组合的 subprocess 能力供给），缺失即在此 fail loud 而非静默把所有 cli locator 判缺失。", "tags": ["fact-defaulting", "fail-loud"], "complexity": "simple"},
  {"id": "function:packages/host/open-in-app/src/resolver.ts:expandCandidate", "type": "function", "name": "expandCandidate", "filePath": "packages/host/open-in-app/src/resolver.ts", "lineRange": [216, 225], "summary": "展开候选模板的 ${VAR} 引用与开头 ~/：任一变量未设即 null（字符串替换保留模板的 / 分隔，Win32 API 接受）。", "tags": ["expansion", "candidates"], "complexity": "simple"},
  {"id": "function:packages/host/open-in-app/src/resolver.ts:parseRegistryDump", "type": "function", "name": "parseRegistryDump", "filePath": "packages/host/open-in-app/src/resolver.ts", "lineRange": [274, 291], "summary": "解析 reg.exe query /s 输出：HK 行开新 subkey、缩进行按 REG_SZ/REG_EXPAND_SZ token 列匹配（默认值标记本地化，统一归 (Default) 名）。", "tags": ["parsing", "registry", "locale-tolerance"], "complexity": "moderate"},
  {"id": "function:packages/host/open-in-app/src/resolver.ts:readWindowsRegistryView", "type": "function", "name": "readWindowsRegistryView", "filePath": "packages/host/open-in-app/src/resolver.ts", "lineRange": [301, 333], "summary": "每根一次 reg.exe query 建 Windows 注册表事实：App Paths 表（用户 hive 优先遮蔽机器级）+ Uninstall 记录（DisplayName/InstallLocation/DisplayIcon），失败根贡献为空。", "tags": ["registry-view", "app-paths", "uninstall-records"], "complexity": "moderate"},
