  {"id": "file:packages/host/open-in-app/src/shared.ts", "type": "file", "name": "shared.ts", "filePath": "packages/host/open-in-app/src/shared.ts", "summary": "host 路由与浏览器包逐字共享的路由路径与 wire 载荷（./shared 子路径）：apps/icon 前缀/open 三路由的绝对 pathname 与 document-relative 形态、OpenInAppAppsPayload/OpenInAppOpenPayload；纯常量与类型，浏览器安全。", "tags": ["shared-contract", "wire-payloads", "browser-safe"], "complexity": "simple"},
