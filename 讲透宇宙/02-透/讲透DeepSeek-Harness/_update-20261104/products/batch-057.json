 "nodes": [
  {"id": "file:packages/host/open-in-app/src/icons.ts", "type": "file", "name": "icons.ts", "filePath": "packages/host/open-in-app/src/icons.ts", "summary": "open-in-app 图标提取（一平台一策略）：macOS plutil 读 Info.plist CFBundleIconFile（可缺 .icns 后缀，回退 Resources 首个 .icns）+sips 转 128px PNG；Windows 生成 PowerShell 脚本经 ExtractAssociatedIcon 取 32px PNG（.NET 原生面上限）；Linux 沿 desktop entry Icon= 键进 hicolor/pixmaps（PNG/SVG 零子进程）；失败归 null，路由答 404 由浏览器渲染通用字形。", "tags": ["icon-extraction", "platform-strategies", "powershell"], "complexity": "complex"},
