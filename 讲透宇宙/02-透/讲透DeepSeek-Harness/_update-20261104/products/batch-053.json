 "nodes": [
  {"id": "document:packages/spill/README.md", "type": "document", "name": "README.md", "filePath": "packages/spill/README.md", "summary": "spill 包组 README：模型上下文外全文存储家族——spill/ 存储服务定义、spill-local/ 本机文件系统后端、spill-policy/ 工具结果策略；工具结果 spill 由 maxInlineTokens 选配，存储失败保留原文；session-reference 截断捕获也直接消费存储。", "tags": ["documentation", "package-group", "spill"], "complexity": "simple"},
  {"id": "document:packages/spill/spill/README.md", "type": "document", "name": "README.md", "filePath": "packages/spill/spill/README.md", "summary": "dsh-spill 包 README：ctx.spillStore 公共 API 保存超限文本并返回不透明 locator/精确字节/检索指引；不做保留、替换、检索与搜索，保存失败即 reject。", "tags": ["documentation", "service-definition", "spill"], "complexity": "moderate"},
  {"id": "config:packages/spill/spill/package.json", "type": "config", "name": "package.json", "filePath": "packages/spill/spill/package.json", "summary": "@deepseek-ai/dsh-spill 包清单：spill 存储能力缝的 ESM 导出与 cordis peer 依赖。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "file:packages/spill/spill/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/spill/spill/src/index.ts", "summary": "spill 存储能力缝的 Service Definition：抽象类 SpillStore（ctx.spillStore）只定义 saveText（持久化全文并返回 locator+字节长度+模型检索指引）；有意不拥有保留策略/工具结果替换/检索 API——这些分别属 output-retention、spill-policy 与后端。", "tags": ["service-definition", "capability-seam", "abstract-service", "spill"], "complexity": "simple"},
  {"id": "class:packages/spill/spill/src/index.ts:SpillStore", "type": "class", "name": "SpillStore", "filePath": "packages/spill/spill/src/index.ts", "lineRange": [45, 56], "summary": "抽象 Service 子类（Service Definition 角色）：构造注册为 spillStore（同 ctx 二次加载按 cordis 重复服务抛错）；唯一抽象方法 saveText 语义——全文逐字持久化、会话作用域私有位置、名字由 suggestedName 派生但不相等、真实存储失败必须 reject。", "tags": ["service-definition", "abstract-class", "cordis-service"], "complexity": "simple"},
  {"id": "file:packages/spill/spill/src/types.ts", "type": "file", "name": "types.ts", "filePath": "packages/spill/spill/src/types.ts", "summary": "spill 词汇表：Branded SpillLocator（模型侧不透明句柄）、SpillOwner（会话命名空间，fork 会话继承既有 locator）、SpillSource（tool/session-reference 判别联合）、SaveTextSpill 与 SpillRef（locator+bytes+retrievalHint）。", "tags": ["type-definition", "branded-id", "discriminated-union"], "complexity": "moderate"},
  {"id": "function:packages/spill/spill/src/types.ts:SpillLocator", "type": "function", "name": "SpillLocator", "filePath": "packages/spill/spill/src/types.ts", "lineRange": [26, 28], "summary": "把后端产出的 locator 字符串品牌化为 SpillLocator。", "tags": ["branding", "type-guard"], "complexity": "simple"},
  {"id": "config:packages/spill/spill/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/spill/spill/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"},
  {"id": "document:packages/spill/spill-local/README.md", "type": "document", "name": "README.md", "filePath": "packages/spill/spill-local/README.md", "summary": "dsh-spill-local 包 README：把超限文本存为本机私有、会话作用域文件并以路径为 locator（指引模型 read/grep）；文件仅当前用户可读、名字不可预测、每会话稳定目录分组，防共享根泄漏与植入 symlink 重定向；配置选根目录与启动清理保留期。", "tags": ["documentation", "local-storage", "security"], "complexity": "moderate"},
  {"id": "config:packages/spill/spill-local/package.json", "type": "config", "name": "package.json", "filePath": "packages/spill/spill-local/package.json", "summary": "@deepseek-ai/dsh-spill-local 包清单：本机文件系统 spill 后端的依赖与导出。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "config:packages/spill/spill-local/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/spill/spill-local/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"},
  {"id": "document:packages/spill/spill-policy/README.md", "type": "document", "name": "README.md", "filePath": "packages/spill/spill-policy/README.md", "summary": "dsh-spill-policy 包 README：共享估算 token 预算内保留超限文本与图像结果——模型收有序 head/tail 内容与全文路径；图像留在附件存储，结果文件记录可读路径；省略 maxInlineTokens 即停用，恢复失败保留原内容。", "tags": ["documentation", "token-budget", "retention-policy"], "complexity": "moderate"},
  {"id": "config:packages/spill/spill-policy/package.json", "type": "config", "name": "package.json", "filePath": "packages/spill/spill-policy/package.json", "summary": "@deepseek-ai/dsh-spill-policy 包清单：工具结果保留策略插件的依赖与导出。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "file:packages/spill/spill-policy/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/spill/spill-policy/src/index.ts", "summary": "函数插件 spill-policy（inject tools，maxInlineTokens 省略即停用）：tools/post-execute 与 tools/ptc-dispatch-log 双 prepend 钩子上对可保留内容（text/image）计价（图像按 provider/model 的 imageRequestPricing+描述文本估算），超预算时经 ctx.spillStore.saveText 全文落盘，head/tail 保留并附 formatSpillNotice 页脚；任何失败仅告警并保留内联原文。", "tags": ["plugin", "token-budget", "tool-result-policy", "post-execute-hook"], "complexity": "complex", "languageNotes": "apply 内嵌 pricing/fullText/bound 三个闭包：bound 先为最坏通知预留预算再 retainContent，相邻 text 块合并以省 framing 成本；PTC 文本绑定走异步 dispatch-log 通道，含图像的 PTC 替换把预览补进 additionalContexts。"},
  {"id": "function:packages/spill/spill-policy/src/index.ts:apply", "type": "function", "name": "apply", "filePath": "packages/spill/spill-policy/src/index.ts", "lineRange": [49, 157], "summary": "校验 maxInlineTokens 非负整数后挂两个 prepend 监听：post-execute 对 accept 且非 read 工具的结果做界内保留（PTC 子调用仅纯文本走 dispatch 路径）；ptc-dispatch-log 对异步日志副本同样 bound；成功替换返回新 accept decision。", "tags": ["plugin-entry", "waterfall-listener", "ptc-integration"], "complexity": "complex"},
  {"id": "file:packages/spill/spill-policy/src/notice.ts", "type": "file", "name": "notice.ts", "filePath": "packages/spill/spill-policy/src/notice.ts", "summary": "浏览器安全的 spill 通知格式化与识别：formatSpillNotice 产出与持久化拼写一致的“(省略 N bytes[ Omitted M images.] 全文存于: locator. 指引)”通知；hasSpillNotice 从文本尾部识别完整通知（识别文本约定而非鉴权来源）。", "tags": ["notice-formatting", "notice-recognition", "browser-safe"], "complexity": "moderate"},
  {"id": "function:packages/spill/spill-policy/src/notice.ts:formatSpillNotice", "type": "function", "name": "formatSpillNotice", "filePath": "packages/spill/spill-policy/src/notice.ts", "lineRange": [21, 24], "summary": "按固定拼写组装省略字节数（可选省略图像数）+存储位置+检索指引的括号通知。", "tags": ["formatting", "stable-spelling"], "complexity": "simple"},
  {"id": "function:packages/spill/spill-policy/src/notice.ts:hasSpillNotice", "type": "function", "name": "hasSpillNotice", "filePath": "packages/spill/spill-policy/src/notice.ts", "lineRange": [45, 59], "summary": "从结尾括号起逐段扫描分隔符界定的候选，校验省略段拼写与位置/指引段存在，识别文本末尾的完整 spill 通知。", "tags": ["recognition", "parsing", "convention"], "complexity": "moderate"},
  {"id": "file:packages/spill/spill-policy/src/retention.ts", "type": "file", "name": "retention.ts", "filePath": "packages/spill/spill-policy/src/retention.ts", "summary": "文本与不可分割图像的有序 head/tail 保留：预算对半分给两端，fitText 二分求单调估算下最大可容纳文本端（textSlice 处理代理对切割），图像要么整个保留要么整个省略；返回保留两端与精确省略字节/图像计数。", "tags": ["retention", "binary-search", "surrogate-pairs", "budget-split"], "complexity": "complex"},
  {"id": "function:packages/spill/spill-policy/src/retention.ts:retainContent", "type": "function", "name": "retainContent", "filePath": "packages/spill/spill-policy/src/retention.ts", "lineRange": [48, 104], "summary": "从头尾双向贪心装块：文本块超出剩余预算时 fitText 截断，跨界共享文本块在尾侧剔除头侧已留字符；最后按 UTF-8 字节与图像数计算省略统计。", "tags": ["two-ended-greedy", "text-truncation", "accounting"], "complexity": "complex"},
  {"id": "config:packages/spill/spill-policy/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/spill/spill-policy/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"}
 ],
