   "lineRange": [
    55,
    70
   ],
   "summary": "在工具 JSON 边界校验模型提供的查询字段：entry/name 必须非空字符串，offset 非负整数，limit 1-100（默认 25），坏值即抛错。",
   "tags": [
    "validation",
    "json-boundary",
    "query-parsing"
   ],
   "complexity": "simple"
  },
