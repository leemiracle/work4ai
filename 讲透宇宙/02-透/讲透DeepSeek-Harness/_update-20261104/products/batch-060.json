 "nodes": [
  {"id": "file:packages/client/product-analytics/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/client/product-analytics/src/index.ts", "summary": "桌面专属分析 RPC 与活压缩采集（ProductAnalytics 为 TypertRemoteService 子类，inject deepseekAccount/productTelemetry）：@Remote watchPolicy 流式下发采集策略、report 经鉴权事件入口（禁用实例不查身份不受新事件）；监听 compaction/start 上报 context_compression（manual/auto 触发）；环境快照惰性采集一次复用。", "tags": ["service-provider", "typert-remote", "analytics", "desktop"], "complexity": "complex", "languageNotes": "enabled 是应用所有的 Volatile 布尔（无用户设置面）；settings 在场时显式关闭 auto 配置面。"},
  {"id": "class:packages/client/product-analytics/src/index.ts:ProductAnalytics", "type": "class", "name": "ProductAnalytics", "filePath": "packages/client/product-analytics/src/index.ts", "lineRange": [33, 130], "summary": "Remote 服务核心：构造挂 effect 卸载（停 active+abort 环境查询）、volatile-update 通知监听者、session/event 过滤 compaction/start 上报；环境属性 promise 惰性建一次。", "tags": ["service-provider", "remote-methods", "lifecycle"], "complexity": "complex"},
  {"id": "config:packages/client/product-analytics/tsconfig.client.json", "type": "config", "name": "tsconfig.client.json", "filePath": "packages/client/product-analytics/tsconfig.client.json", "summary": "Client 面 TypeScript 配置：extends tsconfig.base.client.json、rootDir src、outDir lib/types。", "tags": ["configuration", "typescript", "client-face"], "complexity": "simple"},
  {"id": "config:packages/client/product-analytics/tsconfig.host.json", "type": "config", "name": "tsconfig.host.json", "filePath": "packages/client/product-analytics/tsconfig.host.json", "summary": "Host 面 TypeScript 配置：Node 侧编译叶（与 client 面相对）。", "tags": ["configuration", "typescript", "host-face"], "complexity": "simple"},
  {"id": "config:packages/client/product-analytics/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/client/product-analytics/tsconfig.json", "summary": "包级 TypeScript 解决方案根配置：聚合 host/client 双面。", "tags": ["configuration", "typescript", "solution-root"], "complexity": "simple"},
  {"id": "config:packages/client/product-analytics/tsdown.config.ts", "type": "config", "name": "tsdown.config.ts", "filePath": "packages/client/product-analytics/tsdown.config.ts", "summary": "客户端 bundle 构建配置：clientBundle 工厂，hostPhase: true 使 Host 面产物也进 bundle。", "tags": ["build-system", "tsdown", "client-bundle"], "complexity": "simple"},
  {"id": "document:packages/client/resources/README.md", "type": "document", "name": "README.md", "filePath": "packages/client/resources/README.md", "summary": "dsh-client-resources 包 README：组件只按 URL 地址知道活数据（标签记录/链接/提及）而另一客户端包拥有数据时用资源模型——dsh-resource://<type>/… 地址（需作用域的协议把作用域编进路径），组件经公共 useResource hook 收当前值与后续更新；不支持的协议与非资源 scheme（sidebar://guide）解析为无资源。", "tags": ["documentation", "resource-model", "use-resource"], "complexity": "simple"},
  {"id": "config:packages/client/resources/package.json", "type": "config", "name": "package.json", "filePath": "packages/client/resources/package.json", "summary": "@deepseek-ai/dsh-client-resources 包清单：资源模型的依赖与导出（./client 子路径）。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "file:packages/client/resources/src/client/contract.ts", "type": "file", "name": "contract.ts", "filePath": "packages/client/resources/src/client/contract.ts", "summary": "资源模型发布面：dsh-resource:// 地址即资源、协议拥有包注册 ResourceProvider 把地址变帧流、任意 slot 组件经 useResource 读流；ResourceProtocolMap（ui-slots 声明合并）让消费方以类型参数名协议即得拥有者的值类型而不 import 其运行时；none/loading/live/failed 四态 ResourceStatus。", "tags": ["type-definition", "resource-contract", "declaration-merging"], "complexity": "moderate"},
  {"id": "file:packages/client/resources/src/client/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/client/resources/src/client/index.ts", "summary": "浏览器半体插件（inject slots）：apply 顶层（非 effect 内）建 ResourceRegistry 并 reflect.provide resources，effect 先注册最后卸载使面孔活过所有 provider；slots.provideRoot 贡献 resource keyed hook 使 useResource 到达每个 slot 组件。", "tags": ["plugin-entry", "service-provider", "root-hook"], "complexity": "simple"},
  {"id": "function:packages/client/resources/src/client/index.ts:apply", "type": "function", "name": "apply", "filePath": "packages/client/resources/src/client/index.ts", "lineRange": [30, 41], "summary": "建注册表、提供服务面孔（先注册后卸载的次序保证面孔活过 provider）、provideRoot 注入 useResource。", "tags": ["plugin-entry", "hook-contribution"], "complexity": "simple"},
  {"id": "file:packages/client/resources/src/client/resources.ts", "type": "file", "name": "resources.ts", "filePath": "packages/client/resources/src/client/resources.ts", "summary": "ctx.resources 实现：每地址一条永不丢弃的 ResourceRecord（保持 source() 在 React 渲染-订阅窗与 StrictMode 重挂载间的引用稳定，避免每渲染重订阅重启流），holders（订阅+pin）正即跑流、AbortController 控流、SnapshotStore 存快照；最后释放只弃状态回 idle。", "tags": ["resource-registry", "snapshot-store", "reference-stability"], "complexity": "complex"},
  {"id": "function:packages/client/resources/src/client/resources.ts:protocolOf", "type": "function", "name": "protocolOf", "filePath": "packages/client/resources/src/client/resources.ts", "lineRange": [56, 68], "summary": "从地址提取协议键（dsh-resource:// URL 的 host 小写）；其他 scheme 或不可解析地址命名无协议。", "tags": ["address-parsing", "url-scheme"], "complexity": "simple"},
  {"id": "class:packages/client/resources/src/client/resources.ts:ResourceRegistry", "type": "class", "name": "ResourceRegistry", "filePath": "packages/client/resources/src/client/resources.ts", "lineRange": [75, 211], "summary": "注册表核心：register（协议→值类型擦除的 provider）、pin/source（可观察快照）、hold/release 订阅与固定计数控流生命周期、attach/detach 动态扩缩。", "tags": ["registry", "stream-lifecycle"], "complexity": "complex"},
  {"id": "file:packages/client/resources/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/client/resources/src/index.ts", "summary": "纯 Host 半体：资源模型对 host 树零贡献，apply 为空。", "tags": ["plugin-entry", "host-half"], "complexity": "simple"},
  {"id": "config:packages/client/resources/tsconfig.json", "type": "config", "name": "tsconfig.json", "filePath": "packages/client/resources/tsconfig.json", "summary": "包级 TypeScript 配置：extends 基座、rootDir src、outDir lib/types 并引用工作区依赖。", "tags": ["configuration", "typescript"], "complexity": "simple"},
  {"id": "config:packages/client/resources/tsdown.config.ts", "type": "config", "name": "tsdown.config.ts", "filePath": "packages/client/resources/tsdown.config.ts", "summary": "客户端 bundle 构建配置：clientBundle 工厂以 lib/types/index.js 为入口。", "tags": ["build-system", "tsdown", "client-bundle"], "complexity": "simple"},
  {"id": "document:packages/client/shortcuts/README.md", "type": "document", "name": "README.md", "filePath": "packages/client/shortcuts/README.md", "summary": "dsh-client-shortcuts 包 README：按设备定制应用键盘命令——Desktop 与 Web 为接收设备选各自默认、自定义绑定同设备重载存活、命令随拥有插件卸载消失而保存的覆盖保留待重装；Windows 修饰键与首普通键间用 + ，两普通键并排（F G）在 Windows/macOS Desktop 呈现（含工具提示与快捷键参考）。", "tags": ["documentation", "keyboard-shortcuts", "per-device"], "complexity": "simple"},
  {"id": "config:packages/client/shortcuts/package.json", "type": "config", "name": "package.json", "filePath": "packages/client/shortcuts/package.json", "summary": "@deepseek-ai/dsh-client-shortcuts 包清单：键盘命令服务的依赖与导出（./client 子路径）。", "tags": ["configuration", "package-manifest"], "complexity": "simple"},
  {"id": "file:packages/client/shortcuts/src/binding.ts", "type": "file", "name": "binding.ts", "filePath": "packages/client/shortcuts/src/binding.ts", "summary": "浏览器命令与桌面适配器共享的物理键协议（无 DOM 无运行时态）：ShortcutBinding（1-2 个物理键+修饰集）、logical primary 展开（macOS→Meta 其他→Control）、normalizeBinding 规范化（键码白名单+去重+修饰定序）、presentBinding 键帽呈现、isWebBindingAllowed Web 限制。", "tags": ["binding-protocol", "normalization", "keycaps"], "complexity": "moderate"},
  {"id": "function:packages/client/shortcuts/src/binding.ts:normalizeBinding", "type": "function", "name": "normalizeBinding", "filePath": "packages/client/shortcuts/src/binding.ts", "lineRange": [41, 53], "summary": "展开逻辑修饰、键码排序去重（白名单 Key/Digit/F1-24/命名键，不支持即抛）、修饰按 control-alt-shift-meta 定序。", "tags": ["normalization", "validation"], "complexity": "simple"},
  {"id": "function:packages/client/shortcuts/src/binding.ts:presentBinding", "type": "function", "name": "presentBinding", "filePath": "packages/client/shortcuts/src/binding.ts", "lineRange": [71, 88], "summary": "把规范绑定呈现为平台键帽文本（命名键转字形、双键并排）。", "tags": ["presentation", "keycaps"], "complexity": "simple"},
  {"id": "function:packages/client/shortcuts/src/binding.ts:isWebBindingAllowed", "type": "function", "name": "isWebBindingAllowed", "filePath": "packages/client/shortcuts/src/binding.ts", "lineRange": [96, 112], "summary": "判定 Web 运行时是否允许某绑定（浏览器保留组合的限制集）。", "tags": ["web-restrictions"], "complexity": "simple"},
  {"id": "file:packages/client/shortcuts/src/client/dom.ts", "type": "file", "name": "dom.ts", "filePath": "packages/client/shortcuts/src/client/dom.ts", "summary": "主文档键盘适配器：detectEnvironment 探测访问设备（永不看服务器 OS——documentElement dataset.platform 标记 Electron preload）；installKeyboard 装输入法组合跟踪、modal 缓存失效与本地控件仲裁后的派发（本地控件先于窗口冒泡截流）。", "tags": ["dom-adapter", "environment-detection", "input-arbitration"], "complexity": "complex"},
  {"id": "function:packages/client/shortcuts/src/client/dom.ts:detectEnvironment", "type": "function", "name": "detectEnvironment", "filePath": "packages/client/shortcuts/src/client/dom.ts", "lineRange": [13, 21], "summary": "由 document 平台标记（缺省即 web）与 navigator.platform 判 runtime 与 platform。", "tags": ["detection"], "complexity": "simple"},
  {"id": "function:packages/client/shortcuts/src/client/dom.ts:installKeyboard", "type": "function", "name": "installKeyboard", "filePath": "packages/client/shortcuts/src/client/dom.ts", "lineRange": [31, 116], "summary": "装文档级监听：组合观察、modal 选择器缓存、dead-key 与 blur 复位固定序列、本地 handler 之后的注册表派发；返回释放全部监听/观察/节点的 disposer。", "tags": ["listener-installation", "modal-awareness"], "complexity": "complex"},
  {"id": "file:packages/client/shortcuts/src/client/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/client/shortcuts/src/client/index.ts", "summary": "浏览器命令服务（ShortcutsService 为 Service 子类，ctx.shortcuts，inject locale，每插件寿命一个键盘适配器）：detectEnvironment 分 web/desktop（desktop 缺 dshDesktop.keyboard 桥即抛）；web 用 localStorage 存储、desktop 用 preload 的 DesktopShortcutsApi（永不回落浏览器存储）；注册/固定命令、配置同步与录制编辑窗口。", "tags": ["service-provider", "keyboard-adapters", "dual-storage"], "complexity": "complex"},
  {"id": "class:packages/client/shortcuts/src/client/index.ts:ShortcutsService", "type": "class", "name": "ShortcutsService", "filePath": "packages/client/shortcuts/src/client/index.ts", "lineRange": [27, 159], "summary": "窗口本地应用命令服务：构造 ShortcutRegistry+环境适配器，register/registerFixed 注册命令、observeFixedInput 固定序列观察、syncDefinitions/failRead 存储往返、edit/recording 偏好编辑与录制、closeWindow 收尾。", "tags": ["service-provider", "command-registration"], "complexity": "complex"},
  {"id": "file:packages/client/shortcuts/src/client/native.ts", "type": "file", "name": "native.ts", "filePath": "packages/client/shortcuts/src/client/native.ts", "summary": "桌面手势的原生键盘路由：installNativeKeyboard 把原生菜单/主帧/嵌入帧输入经共享命令注册表派发——活焦点沿 shadowRoot 深入（webview 侧栏帧除外）、modal 顶叠判上下文、terminal/editable/page 区域分类。", "tags": ["native-keyboard", "focus-traversal", "context-classification"], "complexity": "moderate"},
  {"id": "function:packages/client/shortcuts/src/client/native.ts:installNativeKeyboard", "type": "function", "name": "installNativeKeyboard", "filePath": "packages/client/shortcuts/src/client/native.ts", "lineRange": [15, 45], "summary": "订阅 preload 键盘桥：revision 匹配当前快照才受理，菜单输入 invoke、键盘输入 dispatch，返回释放 disposer。", "tags": ["bridge-subscription", "revision-check"], "complexity": "moderate"},
  {"id": "file:packages/client/shortcuts/src/client/registry.ts", "type": "file", "name": "registry.ts", "filePath": "packages/client/shortcuts/src/client/registry.ts", "summary": "命令注册、规范默认绑定与同步派发：commands/fixedCommands 双表、bindings 键→命令、conflicts 冲突表（冲突行保留请求绑定但不可执行）；catalog/config 双可观察快照（有效本地化行与已接受偏好+读诊断）；dispatch 消费与后续业务操作成败无关。", "tags": ["registry", "dispatch", "conflict-tracking"], "complexity": "complex"},
  {"id": "class:packages/client/shortcuts/src/client/registry.ts:ShortcutRegistry", "type": "class", "name": "ShortcutRegistry", "filePath": "packages/client/shortcuts/src/client/registry.ts", "lineRange": [14, 180], "summary": "注册表核心：register/registerFixed（normalizeBinding 校验+冲突记账）、configure 接受偏好快照刷新有效行、invoke/dispatch 同步命令调用与键派发、definitions 序列化供存储验证。", "tags": ["registry-core", "snapshot-stores"], "complexity": "complex"},
  {"id": "file:packages/client/shortcuts/src/client/storage.ts", "type": "file", "name": "storage.ts", "filePath": "packages/client/shortcuts/src/client/storage.ts", "summary": "显式浏览器与桌面偏好适配器：webShortcutStorage 连 localStorage（dsh.keybindings.v1）与同源外部更新（storage 事件）到共享事务协调器；desktopShortcutStorage 读 origin 作用域 preload 能力（dshDesktop.shortcuts），缺桥是显式配置失败——桌面永不回落浏览器存储。", "tags": ["storage-adapters", "localStorage", "preload-bridge"], "complexity": "simple"},
  {"id": "function:packages/client/shortcuts/src/client/storage.ts:webShortcutStorage", "type": "function", "name": "webShortcutStorage", "filePath": "packages/client/shortcuts/src/client/storage.ts", "lineRange": [15, 31], "summary": "ShortcutPersistence 包 localStorage 读写并监听 storage 事件，返回带 dispose 的 DesktopShortcutsApi 形态适配器。", "tags": ["web-storage", "cross-tab-sync"], "complexity": "simple"},
  {"id": "function:packages/client/shortcuts/src/client/storage.ts:desktopShortcutStorage", "type": "function", "name": "desktopShortcutStorage", "filePath": "packages/client/shortcuts/src/client/storage.ts", "lineRange": [38, 40], "summary": "读 window.dshDesktop.shortcuts 受限桌面 API，缺桥返回 undefined。", "tags": ["desktop-storage"], "complexity": "simple"},
  {"id": "file:packages/client/shortcuts/src/client/types.ts", "type": "file", "name": "types.ts", "filePath": "packages/client/shortcuts/src/client/types.ts", "summary": "命令贡献与不可变目录值：ShortcutRegion（page/editable/terminal）、ShortcutContext（同步 DOM 上下文，业务目标在 resolve 捕获）、ShortcutResolution（handled/blocked/pass）、ShortcutCommand（标签/别名/默认/区域/解析器）与 Shortcuts 服务面。", "tags": ["type-definition", "command-contract"], "complexity": "moderate"},
  {"id": "file:packages/client/shortcuts/src/config.ts", "type": "file", "name": "config.ts", "filePath": "packages/client/shortcuts/src/config.ts", "summary": "窗口本地键盘时序配置：stopSequenceMs（停止回复的连续 Escape 最大间隔，默认 500ms）的 schema 校验。", "tags": ["configuration", "schema"], "complexity": "simple"},
  {"id": "file:packages/client/shortcuts/src/configuration.ts", "type": "file", "name": "configuration.ts", "filePath": "packages/client/shortcuts/src/configuration.ts", "summary": "无浏览器依赖的偏好文档校验与确定性冲突消解：ShortcutDocument（schemaVersion 1|2、按 profile 的覆盖，null 显式解绑、缺失命令承默认）、parseBinding/parseShortcutDocument（未知字段拒绝防有损重写）、effectiveShortcuts 算有效行（冲突保留可见不可执行）、editShortcutDocument/parseShortcutDefinitions 编辑与定义解析。", "tags": ["configuration-parsing", "conflict-resolution", "deterministic"], "complexity": "complex"},
  {"id": "function:packages/client/shortcuts/src/configuration.ts:parseBinding", "type": "function", "name": "parseBinding", "filePath": "packages/client/shortcuts/src/configuration.ts", "lineRange": [40, 55], "summary": "规范化前校验 JSON 绑定字段：仅 code/secondCode/modifiers 三键、类型严格，未知字段拒绝。", "tags": ["validation", "strict-parsing"], "complexity": "simple"},
  {"id": "function:packages/client/shortcuts/src/configuration.ts:parseShortcutDocument", "type": "function", "name": "parseShortcutDocument", "filePath": "packages/client/shortcuts/src/configuration.ts", "lineRange": [62, 87], "summary": "解析完整偏好文档：schemaVersion/profiles 结构校验、命令 id 模式匹配、逐绑定 parseBinding。", "tags": ["document-parsing"], "complexity": "moderate"},
  {"id": "function:packages/client/shortcuts/src/configuration.ts:effectiveShortcuts", "type": "function", "name": "effectiveShortcuts", "filePath": "packages/client/shortcuts/src/configuration.ts", "lineRange": [135, 152], "summary": "由定义与已接受偏好算有效快捷方式集：缺失命令承默认、冲突与保留/不支持浏览器等 issue 归类。", "tags": ["effective-config", "issues"], "complexity": "moderate"},
  {"id": "function:packages/client/shortcuts/src/configuration.ts:editShortcutDocument", "type": "function", "name": "editShortcutDocument", "filePath": "packages/client/shortcuts/src/configuration.ts", "lineRange": [174, 191], "summary": "应用一条 revision 校验的偏好编辑（set/reset/reset-all，限当前 runtime:platform）产出新文档。", "tags": ["editing", "revision-check"], "complexity": "simple"},
  {"id": "function:packages/client/shortcuts/src/configuration.ts:parseShortcutDefinitions", "type": "function", "name": "parseShortcutDefinitions", "filePath": "packages/client/shortcuts/src/configuration.ts", "lineRange": [212, 244], "summary": "解析可信产品帧来的可序列化命令定义（id/defaults/fixed），供存储往返验证。", "tags": ["definitions-parsing"], "complexity": "moderate"},
  {"id": "file:packages/client/shortcuts/src/index.ts", "type": "file", "name": "index.ts", "filePath": "packages/client/shortcuts/src/index.ts", "summary": "Host 半体插件：apply 在 webserver/index-inject 表注入 __DSH_SHORTCUTS_CONFIG__ 全局（页面加载时采用的固定序列时序）。", "tags": ["plugin-entry", "host-half", "index-inject"], "complexity": "simple"},
  {"id": "function:packages/client/shortcuts/src/index.ts:apply", "type": "function", "name": "apply", "filePath": "packages/client/shortcuts/src/index.ts", "lineRange": [15, 19], "summary": "把校验后的键盘配置注入产品页面的索引全局。", "tags": ["plugin-entry", "config-injection"], "complexity": "simple"}
