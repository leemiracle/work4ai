# ===== 上游克隆/大体积资源 (可重新获取, 通过 manifest 记录来源) =====
# 主仓库 (PKUFlyingPig/cs-self-learning 上游克隆)
cs-self-learning/
# GitHub 克隆仓库 (21GB)
github-repos/
# PDF / 大书
books/
# 网站镜像 (可由 cs-self-learning 重新构建)
website/

# ===== 以下为本项目自建智能化层 (会入库) =====
# tools/        脚本工具
# manifest/     资源清单与索引
# graph/        知识图谱
# rag/          RAG 配置与 prompt
# docs/         项目文档
# site-config/  mkdocs 等站点配置

# ===== 项目边界 (YAGNI): 以下目录不属于 csdiy 核心 =====
# 如被其他 AI 工作流创建，一律忽略
analytics/
android-*/
cache/
codegen/
collaboration/
custom-templates/
learning/
memory/
predictive/
prompt-library/
swarm/
templates/
output/
tmp/

# ===== Python =====
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# ===== 构建产物 / 索引 =====
index/
*.index
*.bin
chroma/
*.sqlite
*.db
# 但保留已提交的轻量索引样本
!index/.gitkeep

# ===== 系统/编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ===== 每日训练器状态（个人复习进度，不入库） =====
.daily_state.json
.daily_state.json.tmp

# ===== 临时 =====
tmp/
*.log
