{
  "project": {
    "name": "Paper-OS Deep Learning System",
    "version": "2.0.0",
    "description": "AI论文深度学习与资源整合系统"
  },
  "paths": {
    "base_dir": "/home/lwz/learn-os/paper-os",
    "data_dir": "data",
    "db_file": "data/paper_os.db",
    "papers_dir": "learning_paths_by_report/extended_papers",
    "learning_paths_dir": "learning_paths_by_report",
    "applications_dir": ".",
    "export_dir": "exports",
    "logs_dir": "logs"
  },
  "database": {
    "type": "sqlite",
    "backup_enabled": true,
    "backup_interval_hours": 24
  },
  "learning": {
    "paths": {
      "beginner": {
        "name": "初学者路径",
        "duration_weeks": 6,
        "papers_count": 2,
        "applications_count": 4
      },
      "intermediate": {
        "name": "中级路径",
        "duration_weeks": 12,
        "papers_count": 3,
        "applications_count": 3
      },
      "advanced": {
        "name": "高级路径",
        "duration_weeks": 16,
        "papers_count": 3,
        "applications_count": 4
      }
    },
    "difficulty_levels": ["初级", "中级", "高级"],
    "importance_levels": ["⭐ 新兴论文", "⭐⭐ 低影响力", "⭐⭐⭐ 中等影响力", "⭐⭐⭐⭐ 高影响力", "⭐⭐⭐⭐⭐ 极高影响力"]
  },
  "features": {
    "progress_tracking": true,
    "note_management": true,
    "quiz_system": true,
    "code_practice": true,
    "rag_qa": true,
    "knowledge_graph": true,
    "project_generator": true,
    "code_browser": true,
    "auto_evaluation": true
  },
  "export_formats": ["json", "markdown", "csv", "pdf"]
}
