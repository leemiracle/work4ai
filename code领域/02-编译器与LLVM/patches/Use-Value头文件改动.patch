+///    │ Val = %a │             │
+///    │ User = %2│             │
+///    └─────────┘             │
+///           ↓                  │
+///          nullptr              │
+///           ↑                  │
+///           └──────────────────┘
+///
+/// Def-Use（从%1指令的角度）：
